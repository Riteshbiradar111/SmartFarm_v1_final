@model IEnumerable<Smart_Farm_and_Crop_Yeild_Management_System.Models.SensorReading>
@{
    Layout = "_DashboardLayout";
    string analysisType = ViewBag.AnalysisType ?? "Soil";
    ViewData["Title"] = $"{analysisType} Analysis";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="text-success mb-1">@analysisType Analysis Console</h2>
        <p class="text-muted">Aggregate environmental metrics, IoT logs, and field reports to monitor regional agricultural health.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4">
    <h5 class="text-dark fw-bold mb-4 border-bottom pb-2">Plot Readings &amp; Sensor Feeds</h5>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Plot Name</th>
                    <th>Farmer / Farm</th>
                    @if (analysisType == "Soil")
                    {
                        <th>Soil pH</th>
                        <th>Moisture Level</th>
                        <th>Nitrogen (N)</th>
                        <th>Phosphorus (P)</th>
                        <th>Potassium (K)</th>
                        <th>Organic Carbon</th>
                    }
                    else if (analysisType == "Weather")
                    {
                        <th>Reported Moisture</th>
                        <th>Location Coordinates</th>
                        <th>Soil Type</th>
                        <th>Irrigation Type</th>
                    }
                    else if (analysisType == "Crop" || analysisType == "Crop Health Analysis")
                    {
                        <th>Crop Health Condition</th>
                        <th>Growth Suitability</th>
                        <th>Soil Moisture</th>
                        <th>pH</th>
                    }
                    else if (analysisType == "Pest")
                    {
                        <th>Pathological Risk</th>
                        <th>Priority Rating</th>
                        <th>Reported Incidents</th>
                    }
                    else // Disease
                    {
                        <th>Risk Assessment</th>
                        <th>Recommended Actions</th>
                        <th>Mitigation Priority</th>
                    }
                    <th>Last Sync</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center py-4 text-muted">No telemetry sensor reading feeds found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var reading in Model)
                    {
                        <tr>
                            <td>
                                <strong class="text-success">@reading.Plot.PlotName</strong>
                                <div class="text-muted small">Code: @reading.Plot.PlotCode</div>
                            </td>
                            <td>
                                <div>@reading.Plot.Farm.Farmer.FullName</div>
                                <div class="text-muted small">@reading.Plot.Farm.FarmName</div>
                            </td>
                            @if (analysisType == "Soil")
                            {
                                <td><span class="badge bg-success-subtle text-success">@reading.SoilPH</span></td>
                                <td><span class="badge bg-info-subtle text-info">@reading.SoilMoisture%</span></td>
                                <td>@reading.Nitrogen mg/kg</td>
                                <td>@reading.Phosphorus mg/kg</td>
                                <td>@reading.Potassium mg/kg</td>
                                <td>@reading.OrganicCarbon%</td>
                            }
                            else if (analysisType == "Weather")
                            {
                                <td>@reading.SoilMoisture% Humidity</td>
                                <td>Lat: @reading.Plot.Latitude | Lng: @reading.Plot.Longitude</td>
                                <td>@reading.Plot.SoilType</td>
                                <td>@reading.Plot.IrrigationType</td>
                            }
                            else if (analysisType == "Crop" || analysisType == "Crop Health Analysis")
                            {
                                <td>
                                    <span class="badge bg-success text-white">Optimal</span>
                                </td>
                                <td>High suitability for loam soil</td>
                                <td>@reading.SoilMoisture%</td>
                                <td>@reading.SoilPH</td>
                            }
                            else if (analysisType == "Pest")
                            {
                                <td>Low Aphid Risk</td>
                                <td><span class="badge bg-info">Medium</span></td>
                                <td>No active infestations</td>
                            }
                            else // Disease
                            {
                                <td>Fungal Rust Risk: Low</td>
                                <td>Proactive spray of Neem Oil suggested</td>
                                <td><span class="badge bg-light text-dark">Routine</span></td>
                            }
                            <td>@reading.LastUpdated.ToString("dd-MM-yyyy HH:mm")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
