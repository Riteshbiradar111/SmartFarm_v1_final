			},
			{
				id: 6,
				name: "Sugarcane",
				scientificName: "Saccharum officinarum",
				season: "annual",
				icon: "🎋",
				color: "#dcfce7",
				soilType: "Deep loamy soil",
				soilpH: "6.5 - 7.5",
				temperature: "20°C - 35°C",
				rainfall: "1500-2500 mm",
				duration: "10-16 months",
				cultivation: [
					"Planting: February-March (spring), October-November (autumn)",
					"Seed rate: 35,000-40,000 two-budded setts per ha",
					"Spacing: 90-120 cm row-to-row",
					"Sett treatment with fungicide before planting",
					"Earthing up: 120-150 days after planting"
				],
				fertilizer: [
					"Basal: 100 kg N + 50 kg P₂O₅ + 60 kg K₂O per ha",
					"Top dressing: 100 kg N in 2 splits (45 and 90 DAP)",
					"Apply 25 tonnes FYM/ha at field preparation",
					"Foliar spray of micronutrients for better cane quality"
				],
				irrigation: [
					"First irrigation: Immediately after planting",
					"Summer: 7-10 day interval",
					"Winter: 15-20 day interval",
					"Critical stages: Tillering, grand growth, and cane formation",
					"Stop irrigation 2-3 weeks before harvest"
				],
				pestManagement: [
					"Early shoot borer: Apply carbofuran 3G [at] 25 kg/ha",
					"Top borer: Release Trichogramma parasites",
					"Red rot: Use disease-free setts, resistant varieties",
					"Smut: Hot water treatment of setts at 52°C for 30 min",
					"Whip smut: Remove and destroy infected shoots"
				],
				recommendation: "Sugarcane is a long-duration crop requiring consistent moisture and nutrient management. Use disease-free and healthy setts for planting. Monitor for borers throughout the season. Ensure proper earthing up and timely irrigation for maximum sugar recovery."
