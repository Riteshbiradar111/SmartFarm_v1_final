				soilpH: "6.0 - 7.0",
				temperature: "15°C - 25°C",
				rainfall: "650-750 mm",
				duration: "140-180 days",
				cultivation: [
					"Nursery sowing: 6-8 weeks before transplanting",
					"Transplanting: When seedlings are 15-20 cm tall",
					"Spacing: 15 × 10 cm",
					"Seed rate: 8-10 kg/ha for direct sowing, 2-3 kg/ha for transplanting",
					"Raised bed cultivation recommended"
				],
				fertilizer: [
					"Basal: 50 kg N + 50 kg P₂O₅ + 50 kg K₂O per ha",
					"Top dressing: 50 kg N in 2 splits (30 and 50 DAT)",
					"Apply 20-25 tonnes FYM/ha",
					"Foliar spray of Sulphur for better bulb quality"
				],
				irrigation: [
					"Light irrigation after transplanting",
					"Irrigation interval: 5-7 days depending on soil type",
					"Critical stages: Bulb formation and enlargement",
					"Stop irrigation 10-15 days before harvesting"
				],
				pestManagement: [
					"Thrips: Spray Fipronil 5% SC [at] 2ml/L or Imidacloprid",
					"Purple blotch: Spray Mancozeb 75% WP [at] 2.5g/L",
					"Stemphylium blight: Spray Carbendazim 50% WP [at] 1g/L",
					"Basal rot: Use healthy bulbs, soil solarization",
					"Onion maggot: Apply phorate 10% CG [at] 10 kg/ha at planting"
