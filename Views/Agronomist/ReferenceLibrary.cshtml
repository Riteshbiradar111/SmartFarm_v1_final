		let currentFilter = 'all';
		let currentSearch = '';

		// Initialize
		document.addEventListener('DOMContentLoaded', function() {
			renderCrops();
			setupEventListeners();
		});

		function setupEventListeners() {
			// Search functionality
			document.getElementById('searchInput').addEventListener('input', function(e) {
				currentSearch = e.target.value.toLowerCase();
				renderCrops();
			});

			// Filter buttons
			document.querySelectorAll('.filter-btn').forEach(btn => {
				btn.addEventListener('click', function() {
					document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
					this.classList.add('active');
					currentFilter = this.dataset.season;
					renderCrops();
				});
			});

			// Close modal on outside click
			document.getElementById('detailModal').addEventListener('click', function(e) {
				if (e.target === this) {
					closeModal();
				}
			});
		}

		function renderCrops() {
			const grid = document.getElementById('referenceGrid');
			const noResults = document.getElementById('noResults');

			let filteredCrops = cropDatabase.filter(crop => {
				const matchesFilter = currentFilter === 'all' || crop.season === currentFilter;
				const matchesSearch = crop.name.toLowerCase().includes(currentSearch) || 
									crop.scientificName.toLowerCase().includes(currentSearch);
				return matchesFilter && matchesSearch;
			});

			if (filteredCrops.length === 0) {
				grid.style.display = 'none';
				noResults.style.display = 'block';
				return;
			}

			grid.style.display = 'grid';
			noResults.style.display = 'none';

			grid.innerHTML = filteredCrops.map(crop => `
				<div class="reference-card" onclick="showDetails(${crop.id})">
					<div class="card-header">
						<div class="crop-icon" style="background: ${crop.color};">
							${crop.icon}
						</div>
						<div class="card-title-section">
							<div class="card-title">${crop.name}</div>
							<div class="card-subtitle">${crop.scientificName}</div>
						</div>
					</div>
					<div class="card-body">
						<div class="info-row">
							<span class="material-icons-round info-icon">thermostat</span>
							<div class="info-content">
								<div class="info-label">Temperature</div>
								<div class="info-value">${crop.temperature}</div>
							</div>
						</div>
						<div class="info-row">
							<span class="material-icons-round info-icon">water_drop</span>
							<div class="info-content">
								<div class="info-label">Rainfall</div>
								<div class="info-value">${crop.rainfall}</div>
							</div>
						</div>
						<div class="info-row">
							<span class="material-icons-round info-icon">schedule</span>
							<div class="info-content">
								<div class="info-label">Duration</div>
								<div class="info-value">${crop.duration}</div>
							</div>
						</div>
					</div>
					<div class="card-footer">
						<span class="tag ${crop.season}">${capitalize(crop.season)} Season</span>
					</div>
				</div>
			`).join('');
		}

		function showDetails(cropId) {
			const crop = cropDatabase.find(c => c.id === cropId);
			if (!crop) return;

			document.getElementById('modalCropName').textContent = `${crop.name}`;
			document.getElementById('modalBody').innerHTML = `
				<div class="detail-section">
					<h3><span class="material-icons-round">info</span> Basic Information</h3>
					<ul>
						<li><strong>Scientific Name:</strong> ${crop.scientificName}</li>
						<li><strong>Season:</strong> ${capitalize(crop.season)}</li>
						<li><strong>Duration:</strong> ${crop.duration}</li>
						<li><strong>Soil Type:</strong> ${crop.soilType}</li>
						<li><strong>Soil pH:</strong> ${crop.soilpH}</li>
						<li><strong>Temperature Range:</strong> ${crop.temperature}</li>
						<li><strong>Rainfall Required:</strong> ${crop.rainfall}</li>
					</ul>
				</div>

				<div class="detail-section">
					<h3><span class="material-icons-round">agriculture</span> Cultivation Practices</h3>
					<ul>
						${crop.cultivation.map(item => `<li>${item}</li>`).join('')}
					</ul>
				</div>

				<div class="detail-section">
					<h3><span class="material-icons-round">eco</span> Fertilizer Management</h3>
					<ul>
						${crop.fertilizer.map(item => `<li>${item}</li>`).join('')}
					</ul>
				</div>

				<div class="detail-section">
					<h3><span class="material-icons-round">water_drop</span> Irrigation Schedule</h3>
					<ul>
						${crop.irrigation.map(item => `<li>${item}</li>`).join('')}
					</ul>
				</div>

				<div class="detail-section">
					<h3><span class="material-icons-round">bug_report</span> Pest & Disease Management</h3>
					<ul>
						${crop.pestManagement.map(item => `<li>${item.replace(/\[at\]/g, '@@')}</li>`).join('')}
					</ul>
				</div>

				<div class="detail-section">
					<h3><span class="material-icons-round">lightbulb</span> Agronomist Recommendation</h3>
					<div class="recommendation-box">
						<p>${crop.recommendation}</p>
					</div>
				</div>
			`;

			document.getElementById('detailModal').classList.add('active');
			document.body.style.overflow = 'hidden';
		}

		function closeModal() {
			document.getElementById('detailModal').classList.remove('active');
			document.body.style.overflow = 'auto';
		}

		function capitalize(str) {
			return str.charAt(0).toUpperCase() + str.slice(1);
		}
	</script>
}
