				duration: "90-120 days",
				cultivation: [
					"Nursery raising: 25-30 days before transplanting",
					"Transplanting: 4-5 weeks old seedlings",
					"Spacing: 75 × 60 cm for indeterminate, 60 × 45 cm for determinate",
