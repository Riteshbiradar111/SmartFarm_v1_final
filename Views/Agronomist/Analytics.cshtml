@{
    Layout = "_DashboardLayout";
    string activeTab = ViewBag.ActiveTab ?? "crop";
    ViewData["Title"] = "Analytics & Trends Console";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="text-success mb-1">Analytics &amp; Trends Console</h2>
        <p class="text-muted">Analyze seasonal crop yields, soil trends and historical crop cycle data over time.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
    <!-- Tabs Header -->
    <ul class="nav nav-pills mb-4 border-bottom pb-3 gap-2" id="analyticsTabs" role="tablist">
        <li class="nav-item-pill" role="presentation">
            <a href="~/Agronomist/Analytics?tab=crop" class="btn @(activeTab == "crop" ? "btn-success" : "btn-light") rounded-3 px-4">
                Crop Performance
            </a>
        </li>
        <li class="nav-item-pill" role="presentation">
            <a href="~/Agronomist/Analytics?tab=soil" class="btn @(activeTab == "soil" ? "btn-success" : "btn-light") rounded-3 px-4">
                Soil Trends
            </a>
        </li>
        <li class="nav-item-pill" role="presentation">
            <a href="~/Agronomist/Analytics?tab=seasonal" class="btn @(activeTab == "seasonal" ? "btn-success" : "btn-light") rounded-3 px-4">
                Seasonal Analysis
            </a>
        </li>
    </ul>

    <!-- Tabs Content -->
    <div class="tab-content" id="analyticsTabsContent">
        @if (activeTab == "crop")
        {
            <div class="tab-pane fade show active">
                <h5 class="text-dark fw-bold mb-3">Crop Yield Performance (Last 3 Seasons)</h5>
                <p class="text-muted small">Visualizes metric tons of harvested crops per acre across regional farms.</p>
                <div style="height: 350px;">
                    <canvas id="cropPerformanceChart"></canvas>
                </div>
            </div>
        }
        else if (activeTab == "soil")
        {
            <div class="tab-pane fade show active">
                <h5 class="text-dark fw-bold mb-3">Soil Nutrient Degradation Trends</h5>
                <p class="text-muted small">Logs averages of Nitrogen (N), Phosphorus (P) and Potassium (K) indices over the last 12 months.</p>
                <div style="height: 350px;">
                    <canvas id="soilNutrientChart"></canvas>
                </div>
            </div>
        }
        else // seasonal
        {
            <div class="tab-pane fade show active">
                <h5 class="text-dark fw-bold mb-3">Seasonal Disease &amp; Weather Stress Indexes</h5>
                <p class="text-muted small">Correlates temperature/humidity metrics to pest incidents and disease reports.</p>
                <div style="height: 350px;">
                    <canvas id="seasonalStressChart"></canvas>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var activeTab = '@activeTab';

            if (activeTab === 'crop') {
                var ctxCrop = document.getElementById('cropPerformanceChart').getContext('2d');
                new Chart(ctxCrop, {
                    type: 'bar',
                    data: {
                        labels: ['Wheat', 'Tomato', 'Cotton', 'Rice', 'Sugarcane'],
                        datasets: [
                            {
                                label: 'Rabi 2024',
                                data: [12.4, 8.5, 6.2, 10.1, 42.0],
                                backgroundColor: '#1B4332'
                            },
                            {
                                label: 'Kharif 2024',
                                data: [11.8, 9.2, 5.8, 11.5, 40.5],
                                backgroundColor: '#2D6A4F'
                            },
                            {
                                label: 'Rabi 2025 (Projected)',
                                data: [13.2, 9.8, 6.5, 12.0, 44.2],
                                backgroundColor: '#52B788'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            } else if (activeTab === 'soil') {
                var ctxSoil = document.getElementById('soilNutrientChart').getContext('2d');
                new Chart(ctxSoil, {
                    type: 'line',
                    data: {
                        labels: ['Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                        datasets: [
                            {
                                label: 'Nitrogen (N)',
                                data: [45, 42, 38, 52, 48, 44, 46, 49, 41, 35, 38, 42],
                                borderColor: '#dc2626',
                                backgroundColor: 'transparent',
                                tension: 0.3
                            },
                            {
                                label: 'Phosphorus (P)',
                                data: [25, 23, 20, 28, 26, 24, 25, 27, 22, 18, 20, 23],
                                borderColor: '#0891b2',
                                backgroundColor: 'transparent',
                                tension: 0.3
                            },
                            {
                                label: 'Potassium (K)',
                                data: [150, 145, 138, 162, 155, 148, 151, 156, 142, 130, 135, 143],
                                borderColor: '#2D6A4F',
                                backgroundColor: 'transparent',
                                tension: 0.3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            } else { // seasonal
                var ctxStress = document.getElementById('seasonalStressChart').getContext('2d');
                new Chart(ctxStress, {
                    type: 'line',
                    data: {
                        labels: ['Monsoon', 'Post-Monsoon', 'Winter', 'Summer'],
                        datasets: [
                            {
                                label: 'Pest Outbreak Index',
                                data: [80, 45, 20, 60],
                                borderColor: '#ef4444',
                                backgroundColor: 'transparent',
                                tension: 0.4
                            },
                            {
                                label: 'Soil Moisture Stress',
                                data: [15, 35, 65, 90],
                                borderColor: '#3b82f6',
                                backgroundColor: 'transparent',
                                tension: 0.4
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }
        });
    </script>
}
