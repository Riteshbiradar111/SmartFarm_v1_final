@model IEnumerable<Smart_Farm_and_Crop_Yeild_Management_System.Models.PestCase>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Pest Incidents";
    var userRole = ViewData["UserRole"] as string ?? "";
}

<div class="row">
    <div class="col-12 d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 text-success">Pest &amp; Crop Disease Cases</h2>
            <p class="text-muted mb-0">Track and review crop health pest cases reported by farmers.</p>
        </div>
        @if (userRole == "Farmer")
        {
            <a href="~/PestCase/Create" class="btn btn-danger d-flex align-items-center gap-2">
                <span class="material-icons-round">bug_report</span>
                Report Pest Incident
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <span class="material-icons-round text-muted" style="font-size: 4rem;">pest_control</span>
                <h4 class="mt-3">No Pest Cases Found</h4>
                <p class="text-muted">There are no reported pest incidents matching your profile.</p>
                @if (userRole == "Farmer")
                {
                    <a href="~/PestCase/Create" class="btn btn-danger mt-2">Report Pest Case</a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="min-width: 800px;">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Reported Date</th>
                            <th>Case Title</th>
                            <th>Crop Name</th>
                            <th>Plot &amp; Farm</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Assigned Officer</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">@item.CreatedDate.ToString("dd-MM-yyyy HH:mm")</td>
                                <td class="fw-semibold text-dark">@item.Title</td>
                                <td class="fw-semibold text-success">@item.CropCycle.Crop.CropName</td>
                                <td>@item.CropCycle.LandPlot.PlotName (@item.CropCycle.LandPlot.Farm.FarmName)</td>
                                <td>
                                    <span class="badge @(item.Priority == "High" ? "bg-danger" : item.Priority == "Medium" ? "bg-warning text-dark" : "bg-info text-dark") px-3 py-1">
                                        @item.Priority
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(item.Status == "Pending" ? "bg-secondary" : item.Status == "Resolved" ? "bg-success" : "bg-warning text-dark") rounded-pill px-3 py-1">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-muted">
                                    @(item.AssignedOfficer != null ? item.AssignedOfficer.Username : "None Assigned")
                                </td>
                                <td class="text-end pe-4">
                                    <a href="~/PestCase/Details/@item.PestCaseId" class="btn btn-sm btn-outline-success border-0 d-inline-flex align-items-center gap-1">
                                        <span class="material-icons-round">visibility</span>
                                        Manage
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
