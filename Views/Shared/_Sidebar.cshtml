@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var role = ViewData["UserRole"] as string ?? "";
}

<div class="nav-section-label">Main Menu</div>

@if (role == "Farmer")
{
    <a href="~/Farmer/Dashboard" class="nav-item" id="nav-dashboard">
        <span class="material-icons-round">home</span>
        <span class="nav-label">Dashboard</span>
    </a>
    <a href="~/LandPlot" class="nav-item" id="nav-plots">
        <span class="material-icons-round">landscape</span>
        <span class="nav-label">My Farm Plots</span>
    </a>
    <a href="~/CropCycle" class="nav-item" id="nav-crops">
        <span class="material-icons-round">grass</span>
        <span class="nav-label">Crop Cycles</span>
    </a>
    <a href="~/LandPlot/SoilWeather" class="nav-item" id="nav-soil">
        <span class="material-icons-round">sensors</span>
        <span class="nav-label">Soil &amp; Weather</span>
    </a>
    <a href="~/PestCase" class="nav-item" id="nav-pest">
        <span class="material-icons-round">bug_report</span>
        <span class="nav-label">Pest Reports</span>
    </a>

