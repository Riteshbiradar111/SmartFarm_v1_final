        <span class="material-icons-round">bookmark</span>
        <span class="nav-label">Saved Items</span>
    </a>
    <a href="~/BuyerMarketplace/FarmerProfiles" class="nav-item" id="nav-sellers">
        <span class="material-icons-round">people</span>
        <span class="nav-label">Seller Directory</span>
