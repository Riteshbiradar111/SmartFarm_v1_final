<div class="nav-section-label">Account</div>
@if (role == "Farmer")
{
    <a href="@Url.Action("Profile", "Farmer")" class="nav-item" id="nav-profile">
        <span class="material-icons-round">person</span>
        <span class="nav-label">My Profile</span>
    </a>
}
else if (role == "Agronomist")
{
    <a href="@Url.Action("Profile", "Agronomist")" class="nav-item" id="nav-profile">
        <span class="material-icons-round">person</span>
        <span class="nav-label">My Profile</span>
    </a>
}
else if (role == "Field Officer")
{
    <a href="@Url.Action("MyProfile", "FieldOfficer")" class="nav-item" id="nav-profile">
        <span class="material-icons-round">person</span>
        <span class="nav-label">My Profile</span>
    </a>
}
else if (role == "Cooperative Manager")
{
    <a href="@Url.Action("MyProfile", "CooperativeManager")" class="nav-item" id="nav-profile">
        <span class="material-icons-round">person</span>
        <span class="nav-label">My Profile</span>
    </a>
}
else if (role == "Buyer")
{
    <a href="@Url.Action("Profile", "Buyer")" class="nav-item" id="nav-profile">
        <span class="material-icons-round">person</span>
        <span class="nav-label">My Profile</span>
    </a>
}
else
{
    <a href="@Url.Action("MyProfile", "Admin")" class="nav-item" id="nav-profile">
        <span class="material-icons-round">person</span>
        <span class="nav-label">My Profile</span>
    </a>
}


