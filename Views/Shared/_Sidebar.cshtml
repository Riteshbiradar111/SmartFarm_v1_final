    <a href="~/Reports" class="nav-item" id="nav-reports">
        <span class="material-icons-round">assessment</span>
        <span class="nav-label">Reports &amp; Analytics</span>
    </a>
    <a href="~/Support" class="nav-item" id="nav-support">
        <span class="material-icons-round">help</span>
        <span class="nav-label">Help &amp; Support</span>
    </a>
}
else if (role == "Agronomist")
{
    <a href="~/Agronomist/Dashboard" class="nav-item" id="nav-dashboard">
        <span class="material-icons-round">dashboard</span>
