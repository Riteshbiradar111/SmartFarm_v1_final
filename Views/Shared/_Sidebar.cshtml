        <span class="material-icons-round">fact_check</span>
        <span class="nav-label">Inspection Status</span>
    </a>
    <a href="~/FieldOfficer/FieldVisits" class="nav-item" id="nav-visits">
        <span class="material-icons-round">directions_walk</span>
        <span class="nav-label">Field Visits</span>
    </a>
