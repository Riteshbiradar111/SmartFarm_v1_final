        <span class="nav-label">Farmer Issues</span>
    </a>

    <a href="~/Agronomist/Analytics" class="nav-item" id="nav-analytics">
        <span class="material-icons-round">bar_chart</span>
        <span class="nav-label">Analytics</span>
    </a>

    <div class="nav-section-label">Resources</div>

    <a href="~/Agronomist/ReferenceLibrary" class="nav-item" id="nav-reference">
        <span class="material-icons-round">menu_book</span>
        <span class="nav-label">Reference Library</span>
    </a>
}
else if (role == "Field Officer")
{
    <a href="~/FieldOfficer/Dashboard" class="nav-item" id="nav-dashboard">
        <span class="material-icons-round">home</span>
        <span class="nav-label">Dashboard</span>
    </a>
    <a href="~/FieldOfficer/PlotMapping" class="nav-item" id="nav-plots">
        <span class="material-icons-round">map</span>
