@model IEnumerable<Smart_Farm_and_Crop_Yeild_Management_System.Models.CultivationRequest>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Farm Improvement Plans";
    var farmers = ViewBag.Farmers as List<Smart_Farm_and_Crop_Yeild_Management_System.Models.Farmer> ?? new List<Smart_Farm_and_Crop_Yeild_Management_System.Models.Farmer>();
    var crops = ViewBag.Crops as List<Smart_Farm_and_Crop_Yeild_Management_System.Models.Crop> ?? new List<Smart_Farm_and_Crop_Yeild_Management_System.Models.Crop>();
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="dash-alert dash-alert-blue mb-4">
        <span class="material-icons-round">check_circle</span>
        <div><b>Success:</b> @TempData["SuccessMessage"]</div>
    </div>
}

<div class="dash-card mb-4">
    <div class="dash-card-header d-flex justify-content-between align-items-center">
        <h2 class="dash-card-title"><span class="material-icons-round">lightbulb</span> Active &amp; Proposed Farm Improvement Plans</h2>
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#newPlanModal">
            <span class="material-icons-round fs-6">add</span> Create Improvement Plan
        </button>
    </div>
    <div class="dash-card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#ID</th>
                        <th>Farmer</th>
                        <th>Target Crop</th>
                        <th>Target Area (Acres)</th>
                        <th>Sowing Target</th>
                        <th>Created Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No improvement plans recorded yet.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var plan in Model)
                        {
                            <tr>
                                <td>#@plan.RequestId</td>
                                <td><strong>@(plan.Farmer?.FullName ?? "Member Farmer")</strong></td>
                                <td><span class="badge bg-success">@(plan.Crop?.CropName ?? "Target Crop")</span></td>
                                <td>@plan.CultivationArea Ac</td>
                                <td>@plan.SowingDate.ToString("dd-MM-yyyy")</td>
                                <td>@plan.CreatedDate.ToString("dd-MM-yyyy")</td>
                                <td>
                                    <span class="badge @(plan.Status == "Approved" ? "bg-success" : "bg-warning text-dark")">@plan.Status</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal to create new Improvement Plan -->
<div class="modal fade" id="newPlanModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="CreateImprovementPlan">
                <div class="modal-header bg-purple text-white" style="background:#7c3aed;">
                    <h5 class="modal-title text-white"><span class="material-icons-round align-middle">lightbulb</span> New Farm Improvement Plan</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Select Farmer</label>
                        <select name="farmerId" class="form-select" required>
                            <option value="">-- Choose Member Farmer --</option>
                            @foreach (var f in farmers)
                            {
                                <option value="@f.FarmerId">@f.FullName (@f.Village)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Target Crop</label>
                        <select name="cropId" class="form-select" required>
                            <option value="">-- Choose Crop --</option>
                            @foreach (var c in crops)
                            {
                                <option value="@c.CropId">@c.CropName (@c.Season)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Target Area (Acres)</label>
                        <input type="number" step="0.1" name="targetArea" class="form-control" placeholder="e.g. 2.5" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="background:#7c3aed; border:none;">Create Plan</button>
                </div>
            </form>
        </div>
    </div>
</div>
