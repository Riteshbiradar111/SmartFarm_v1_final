@model Smart_Farm_and_Crop_Yeild_Management_System.Models.CropOrder
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice - #@Model.InvoiceNumber</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
            body {
                font-family: 'Inter', sans-serif;
                background-color: #fff;
                color: #1a202c;
                padding: 40px;
                margin: 0;
                line-height: 1.5;
            }

            .invoice-card {
                max-width: 800px;
                margin: 0 auto;
                border: 1px solid #e2e8f0;
                border-radius: 8px;
                padding: 40px;
                background-color: #fff;
            }

            .header {
                border-bottom: 2px solid #2b6cb0;
                padding-bottom: 20px;
                margin-bottom: 30px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .header h1 {
                    color: #2b6cb0;
                    margin: 0;
                    font-size: 24px;
                }

                .header p {
                    margin: 5px 0 0 0;
                    color: #718096;
                    font-size: 14px;
                }

            .billing-split {
                display: flex;
                justify-content: space-between;
                margin-bottom: 30px;
                gap: 20px;
            }

            .billing-box {
                width: 48%;
            }

                .billing-box h4 {
                    margin-top: 0;
                    margin-bottom: 10px;
                    color: #2d3748;
                    border-bottom: 1px solid #edf2f7;
                    padding-bottom: 5px;
                    font-size: 14px;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                }

                .billing-box p {
                    margin: 4px 0;
                    font-size: 13px;
                    color: #4a5568;
                }

            .table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 30px;
            }

                .table th {
                    background-color: #f7fafc;
                    border-bottom: 2px solid #edf2f7;
                    color: #4a5568;
                    font-weight: 600;
                    text-align: left;
                    padding: 12px;
                    font-size: 13px;
                }

                .table td {
                    border-bottom: 1px solid #edf2f7;
                    padding: 12px;
                    font-size: 13px;
                    color: #2d3748;
                }

            .totals-box {
                display: flex;
                justify-content: flex-end;
            }

            .totals-table {
                width: 40%;
                border-collapse: collapse;
            }

                .totals-table td {
                    padding: 8px 12px;
                    font-size: 13px;
                    color: #4a5568;
                }

                .totals-table tr.grand-total td {
                    border-top: 2px solid #2b6cb0;
                    font-weight: 700;
                    color: #2b6cb0;
                    font-size: 16px;
                }

            .footer {
                text-align: center;
                color: #a0aec0;
                font-size: 11px;
                margin-top: 50px;
                border-top: 1px solid #edf2f7;
                padding-top: 20px;
            }

            .no-print {
                text-align: right;
                margin-bottom: 20px;
                max-width: 800px;
                margin: 0 auto 20px auto;
            }

            .btn {
                background-color: #2b6cb0;
                color: white;
                border: none;
                padding: 10px 20px;
                font-weight: 600;
                border-radius: 6px;
                cursor: pointer;
                font-family: inherit;
            }

                .btn:hover {
                    background-color: #2c5282;
                }

            @@media print {
                .no-print {
                    display: none !important;
                }

                body {
                    padding: 0;
                }

                .invoice-card {
                    border: none;
                    padding: 0;
                }
            }
    </style>
</head>
<body>
    <div class="no-print">
        <button onclick="window.print()" class="btn">Print / Save as PDF</button>
    </div>

    <div class="invoice-card">
        <div class="header">
            <div>
                <h1>Smart Farm ERP</h1>
                <p>B2B Agricultural Procurement Invoice</p>
            </div>
            <div style="text-align: right;">
                <h3 style="margin: 0; color: #2d3748; font-size: 16px;">Invoice: @Model.InvoiceNumber</h3>
                <p>Date: @Model.OrderDate.ToString("dd-MM-yyyy")</p>
            </div>
        </div>

        <div class="billing-split">
            <!-- Buyer Info -->
            <div class="billing-box">
                <h4>Billed To (Buyer)</h4>
                <p><strong>@Model.Buyer.FullName</strong></p>
                <p>@Model.Buyer.CompanyName</p>
                <p>@Model.Buyer.BusinessAddress</p>
                <p>@Model.Buyer.City, @Model.Buyer.State - @Model.Buyer.PinCode</p>
                <p>Phone: @Model.Buyer.MobileNumber</p>
            </div>

            <!-- Farmer Info -->
            <div class="billing-box">
                <h4>Supplier (Farmer)</h4>
                <p><strong>@Model.Farmer.FullName</strong></p>
                <p>Farmer ID: #@Model.FarmerId</p>
                <p>Mobile: @Model.Farmer.MobileNumber</p>
            </div>
        </div>

        @{
            string cropName = Model.CropListing != null
                ? Model.CropListing.Harvest.CropCycle.Crop.CropName
                : Model.Harvest.CropCycle.Crop.CropName;

            string unit = Model.CropListing != null
                ? Model.CropListing.Unit
                : Model.Harvest.Unit;

            decimal rate = Model.PricePerUnit;
            decimal subtotal = Model.Quantity * rate;
            decimal gstValue = subtotal * 0.05m;
        }

        <table class="table">
            <thead>
                <tr>
                    <th>Item Description</th>
                    <th>Unit Rate (₹)</th>
                    <th>Ordered Quantity</th>
                    <th style="text-align: right;">Subtotal (₹)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <strong>@cropName</strong><br>
                        <small style="color: #718096;">Verified Organic Grade A Produce</small>
                    </td>
                    <td>₹@rate.ToString("0.00") / @unit</td>
                    <td>@Model.Quantity.ToString("0.00") @unit</td>
                    <td style="text-align: right;">₹@subtotal.ToString("N2")</td>
                </tr>
            </tbody>
        </table>

        <div class="totals-box">
            <table class="totals-table">
                <tr>
                    <td>Subtotal:</td>
                    <td style="text-align: right;">₹@subtotal.ToString("N2")</td>
                </tr>
                <tr>
                    <td>GST Tax (5%):</td>
                    <td style="text-align: right;">₹@gstValue.ToString("N2")</td>
                </tr>
                <tr class="grand-total">
                    <td>Grand Total:</td>
                    <td style="text-align: right;">₹@Model.TotalAmount.ToString("N2")</td>
                </tr>
            </table>
        </div>

        <div class="footer">
            Thank you for sourcing through the Cooperative Smart Farm System.
        </div>
    </div>

    <script>
            // Trigger browser print menu on load
            window.addEventListener('DOMContentLoaded', () => {
                setTimeout(() => {
                    window.print();
                }, 500);
            });
    </script>
</body>
</html>
