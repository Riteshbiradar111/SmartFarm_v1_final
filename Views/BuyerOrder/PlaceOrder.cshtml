@model SmartFarmMVC.Models.ViewModels.CropOrderViewModel
@{
	Layout = "_BuyerLayout";
	ViewData["Title"] = "Confirm Order";
}

<div class="row mb-4">
	<div class="col-12">
		<a href="javascript:history.back()" class="text-success d-inline-flex align-items-center gap-1 mb-2 text-decoration-none">
			<span class="material-icons-round">arrow_back</span> Back
		</a>
		<h2 class="text-success mb-1">Confirm Your Order</h2>
		<p class="text-muted mb-0">Review order details before placing your request.</p>
	</div>
</div>

@if (ViewData["ErrorMessage"] != null)
{
	<div class="alert alert-danger mb-4">@ViewData["ErrorMessage"]</div>
}

<div class="row">
	<div class="col-lg-8">
		<!-- Order Details Card -->
		<div class="card border-0 shadow-sm rounded-4 mb-4">
			<div class="card-header bg-white border-0 py-3">
				<h5 class="text-dark fw-bold mb-0">Order Summary</h5>
			</div>
			<div class="card-body">
				<div class="row mb-3">
					<div class="col-sm-4 text-muted small">Product:</div>
					<div class="col-sm-8 fw-bold">@ViewBag.ItemTitle</div>
				</div>
				<div class="row mb-3">
					<div class="col-sm-4 text-muted small">Seller:</div>
					<div class="col-sm-8">@ViewBag.FarmerName</div>
				</div>
				<div class="row mb-3">
					<div class="col-sm-4 text-muted small">Order Type:</div>
					<div class="col-sm-8">
						<span class="badge @(ViewBag.Type == "Harvest Prebook Request" ? "bg-warning-subtle text-warning" : "bg-success-subtle text-success") rounded-pill px-3 py-1">
							@ViewBag.Type
						</span>
					</div>
				</div>
				<div class="row mb-3">
					<div class="col-sm-4 text-muted small">Quantity:</div>
					<div class="col-sm-8 fw-bold">@ViewBag.Quantity @ViewBag.Unit</div>
				</div>
				<div class="row mb-3">
					<div class="col-sm-4 text-muted small">Rate per @ViewBag.Unit:</div>
					<div class="col-sm-8 text-success fw-bold">₹@ViewBag.Rate</div>
				</div>
				<hr />
				<div class="row mb-2">
					<div class="col-sm-4 text-muted small">Subtotal:</div>
					<div class="col-sm-8">₹@ViewBag.Subtotal.ToString("N2")</div>
				</div>
				<div class="row mb-2">
					<div class="col-sm-4 text-muted small">GST (5%):</div>
					<div class="col-sm-8">₹@ViewBag.GST.ToString("N2")</div>
				</div>
				<div class="row mb-0">
					<div class="col-sm-4 fw-bold">Total Amount:</div>
					<div class="col-sm-8 fw-bold text-success fs-5">₹@ViewBag.Total.ToString("N2")</div>
				</div>
			</div>
		</div>

		<!-- Delivery Information Card -->
		<div class="card border-0 shadow-sm rounded-4 mb-4">
			<div class="card-header bg-white border-0 py-3">
				<h5 class="text-dark fw-bold mb-0">Delivery Information</h5>
			</div>
			<div class="card-body">
				<form asp-action="PlaceOrder" method="post">
					@Html.AntiForgeryToken()
					<input type="hidden" asp-for="ListingId" />
					<input type="hidden" asp-for="HarvestId" />
					<input type="hidden" asp-for="Quantity" />

					<!-- Delivery Address -->
					<div class="mb-3">
						<label for="deliveryAddress" class="form-label fw-semibold text-dark">Delivery Address *</label>
						<textarea id="deliveryAddress" asp-for="DeliveryAddress" class="form-control rounded-3" rows="3" placeholder="Enter complete delivery address" required></textarea>
						<small class="text-muted">Include landmark and contact number</small>
						<span asp-validation-for="DeliveryAddress" class="text-danger small"></span>
					</div>

					<!-- Special Instructions -->
					<div class="mb-3">
						<label for="specialInstructions" class="form-label fw-semibold text-dark">Special Instructions (Optional)</label>
						<textarea id="specialInstructions" asp-for="SpecialInstructions" class="form-control rounded-3" rows="2" placeholder="Any special requests or instructions for the farmer"></textarea>
					</div>

					<!-- Terms & Conditions -->
					<div class="form-check mb-3">
						<input class="form-check-input" type="checkbox" id="agreeTerms" required>
						<label class="form-check-label small" for="agreeTerms">
							I agree to the <a href="#" class="text-success">terms and conditions</a> and confirm this order.
						</label>
					</div>

					<div class="d-flex gap-2 justify-content-end">
						<a href="javascript:history.back()" class="btn btn-light rounded-pill px-4">Cancel</a>
						<button type="submit" class="btn btn-success rounded-pill px-4 d-flex align-items-center gap-2">
							<span class="material-icons-round">arrow_forward</span> Proceed to Payment
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- Right Sidebar - Order Status Info -->
	<div class="col-lg-4">
		<div class="card border-0 shadow-sm rounded-4 bg-light">
			<div class="card-body p-4">
				@if (ViewBag.Type == "Harvest Prebook Request")
				{
					<div class="text-center mb-3">
						<span class="material-icons-round text-warning" style="font-size: 3rem;">lock_clock</span>
					</div>
					<h6 class="fw-bold text-dark mb-2">Prebook Order</h6>
					<p class="small text-muted mb-3">
						This is a pre-order request for harvested crops. Once confirmed, a notification will be sent to the farmer.
					</p>
					<div class="alert alert-warning small mb-0">
						<strong>Note:</strong> The farmer will review your request and accept or negotiate the terms. You'll be notified once the farmer responds.
					</div>
				}
				else
				{
					<div class="text-center mb-3">
						<span class="material-icons-round text-success" style="font-size: 3rem;">shopping_cart</span>
					</div>
					<h6 class="fw-bold text-dark mb-2">Standard Purchase</h6>
					<p class="small text-muted mb-3">
						This product is listed on the marketplace and available for immediate purchase.
					</p>
					<div class="alert alert-success small mb-0">
						<strong>Ready to Ship:</strong> Order will be processed immediately after confirmation.
					</div>
				}

				<hr class="my-3" />

				<h6 class="fw-bold text-dark mb-2 small">What happens next?</h6>
				<ul class="small text-muted ps-3 mb-0">
					<li class="mb-1">Review order and proceed to payment</li>
					<li class="mb-1">Complete payment to farmer's account</li>
					<li class="mb-1">Farmer accepts and prepares produce</li>
					<li class="mb-1">Quality check and packaging</li>
					<li class="mb-0">Shipment and delivery tracking</li>
				</ul>
			</div>
		</div>
	</div>
</div>
