@{
    ViewData["Title"] = "Smart Farm & Crop Yield Management System";
    ViewData["Description"] = "Manage farms, crop planning, weather insights, disease tracking, harvest management and produce sales through one integrated platform.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
}

<!-- Sticky Header Navigation -->
<partial name="_Header" />

<!-- ============================================================
     HERO SECTION
============================================================ -->
<section class="hero" id="home">
    <!-- Full-width background image -->
    <div class="hero-bg">
        <img src="https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=1600&q=90"
             alt="Green farm fields aerial view" />
        <div class="hero-overlay"></div>
    </div>

    <!-- Centered hero content -->
    <div class="hero-center">
        <div class="hero-badge">
            <span class="material-icons">verified</span>
            Trusted by 1500+ Farmers Across India
        </div>
        <h1 class="hero-title">
            Smart Farming <br />
            <span class="hero-highlight">Through Technology</span>
        </h1>
        <p class="hero-subtitle">
            Manage farms, crop planning, weather insights, disease tracking,
            harvest management and produce sales through one integrated platform.
        </p>
        <div class="hero-actions">
            <a href="@Url.Action("ChooseType", "Register")" class="btn btn-hero-primary" id="btn-get-started">
                <span class="material-icons">rocket_launch</span>
                Get Started
            </a>
            <a href="#features" class="btn btn-hero-outline">
                <span class="material-icons">explore</span>
                Explore Features
            </a>
        </div>

        <!-- Quick sensor info strip -->
        <div class="hero-sensor-strip">
            <div class="sensor-item">
                <span class="material-icons">water_drop</span>
                <span>Soil Moisture <strong>72%</strong></span>
            </div>
            <div class="sensor-sep"></div>
            <div class="sensor-item">
                <span class="material-icons">thermostat</span>
                <span>Temperature <strong>28°C</strong></span>
            </div>
            <div class="sensor-sep"></div>
            <div class="sensor-item">
                <span class="material-icons">grain</span>
                <span>Soil pH <strong>6.8</strong></span>
            </div>
            <div class="sensor-sep"></div>
            <div class="sensor-item">
                <span class="material-icons">sensors</span>
                <span>IoT Status <strong class="status-live">● Live</strong></span>
            </div>
        </div>

        <!-- Stats bar -->
        <div class="hero-stats">
            <div class="hero-stat">
                <span class="stat-number">1500+</span>
                <span class="stat-label">Active Farmers</span>
            </div>
            <div class="stat-divider"></div>
            <div class="hero-stat">
                <span class="stat-number">5000+</span>
                <span class="stat-label">Acres Managed</span>
            </div>
            <div class="stat-divider"></div>
            <div class="hero-stat">
                <span class="stat-number">3000+</span>
                <span class="stat-label">Harvests Recorded</span>
            </div>
            <div class="stat-divider"></div>
            <div class="hero-stat">
                <span class="stat-number">1000+</span>
                <span class="stat-label">Active Users</span>
            </div>
        </div>
    </div>

    <div class="hero-wave">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none">
            <path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z" fill="#f8faf7" />
        </svg>
    </div>
</section>

<!-- ============================================================
     FEATURES SECTION
============================================================ -->
<section class="features" id="features">
    <div class="section-container">
        <div class="section-header">
            <span class="section-badge">Core Modules</span>
            <h2 class="section-title">Everything You Need to Manage Your Farm</h2>
            <p class="section-subtitle">
                Six powerful modules designed specifically for modern agriculture —
                from land mapping to produce sales.
            </p>
        </div>
        <div class="features-grid">

            <!-- Card 1 -->
            <div class="feature-card">
                <div class="feature-img-wrap">
                    <img src="https://images.unsplash.com/photo-1625246333195-78d9c38ad449?w=500&q=80" alt="Farm land mapping" />
                    <div class="feature-img-overlay">
                        <span class="material-icons feature-overlay-icon">map</span>
                    </div>
                </div>
                <div class="feature-card-body">
                    <div class="feature-icon-wrap green-1">
                        <span class="material-icons">landscape</span>
                    </div>
                    <h3>Farm Registration &amp; Land Plot Mapping</h3>
                    <p>Register farms, define land plots with GPS coordinates, soil type, and area in acres. Full land ownership tracking.</p>
                    <a href="@Url.Action("ChooseType", "Register")" class="feature-link">
                        Learn More <span class="material-icons">arrow_forward</span>
                    </a>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="feature-card">
                <div class="feature-img-wrap">
                    <img src="https://images.unsplash.com/photo-1464226184884-fa280b87c399?w=500&q=80" alt="Crop planning" />
                    <div class="feature-img-overlay">
                        <span class="material-icons feature-overlay-icon">event_note</span>
                    </div>
                </div>
                <div class="feature-card-body">
                    <div class="feature-icon-wrap green-2">
                        <span class="material-icons">grass</span>
                    </div>
                    <h3>Crop Planning &amp; Sowing Schedule</h3>
                    <p>Plan crop cycles, schedule sowing and expected harvest dates. Track crop stages and manage variety selections.</p>
                    <a href="@Url.Action("ChooseType", "Register")" class="feature-link">
                        Learn More <span class="material-icons">arrow_forward</span>
                    </a>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="feature-card">
                <div class="feature-img-wrap">
                    <img src="https://images.unsplash.com/photo-1586771107445-d3ca888129ff?w=500&q=80" alt="Soil and weather monitoring" />
                    <div class="feature-img-overlay">
                        <span class="material-icons feature-overlay-icon">sensors</span>
                    </div>
                </div>
                <div class="feature-card-body">
                    <div class="feature-icon-wrap green-3">
                        <span class="material-icons">cloud</span>
                    </div>
                    <h3>Soil &amp; Weather Monitoring</h3>
                    <p>Real-time IoT sensor data for soil moisture, temperature, pH levels, and rainfall. Automated alerts for anomalies.</p>
                    <a href="@Url.Action("ChooseType", "Register")" class="feature-link">
                        Learn More <span class="material-icons">arrow_forward</span>
                    </a>
                </div>
            </div>

            <!-- Card 4 -->
            <div class="feature-card">
                <div class="feature-img-wrap">
                    <img src="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=500&q=80" alt="Pest and disease tracking" />
                    <div class="feature-img-overlay">
                        <span class="material-icons feature-overlay-icon">pest_control</span>
                    </div>
                </div>
                <div class="feature-card-body">
                    <div class="feature-icon-wrap green-4">
                        <span class="material-icons">bug_report</span>
                    </div>
                    <h3>Pest &amp; Disease Tracking</h3>
                    <p>Report, track and manage pest incidents by severity. Get agronomist recommendations and treatment logs.</p>
                    <a href="@Url.Action("ChooseType", "Register")" class="feature-link">
                        Learn More <span class="material-icons">arrow_forward</span>
                    </a>
                </div>
            </div>

            <!-- Card 5 -->
            <div class="feature-card">
                <div class="feature-img-wrap">
                    <img src="https://images.unsplash.com/photo-1560493676-04071c5f467b?w=500&q=80" alt="Harvest and produce sales" />
                    <div class="feature-img-overlay">
                        <span class="material-icons feature-overlay-icon">shopping_cart</span>
                    </div>
                </div>
                <div class="feature-card-body">
                    <div class="feature-icon-wrap green-5">
                        <span class="material-icons">storefront</span>
                    </div>
                    <h3>Harvest Yield &amp; Produce Sales</h3>
                    <p>Log harvest quantities, list produce for sale, manage buyer transactions, and track market pricing per unit.</p>
                    <a href="@Url.Action("ChooseType", "Register")" class="feature-link">
                        Learn More <span class="material-icons">arrow_forward</span>
                    </a>
                </div>
            </div>

            <!-- Card 6 -->
            <div class="feature-card">
                <div class="feature-img-wrap">
                    <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=500&q=80" alt="Reports and analytics" />
                    <div class="feature-img-overlay">
                        <span class="material-icons feature-overlay-icon">analytics</span>
                    </div>
                </div>
                <div class="feature-card-body">
                    <div class="feature-icon-wrap green-6">
                        <span class="material-icons">bar_chart</span>
                    </div>
                    <h3>Reports &amp; Analytics</h3>
                    <p>Comprehensive dashboards with yield predictions, financial summaries, soil health trends and productivity insights.</p>
                    <a href="@Url.Action("ChooseType", "Register")" class="feature-link">
                        Learn More <span class="material-icons">arrow_forward</span>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ============================================================
     HOW IT WORKS
============================================================ -->
<section class="how-it-works" id="how-it-works">
    <div class="section-container">
        <div class="section-header">
            <span class="section-badge light">Simple Steps</span>
            <h2 class="section-title white">How It Works</h2>
            <p class="section-subtitle white">
                Get started in minutes. Our platform guides you through every step
                of the farming journey.
            </p>
        </div>
        <div class="steps-wrap">
            <div class="steps-line"></div>
            <div class="steps-grid">

                <div class="step-item">
                    <div class="step-circle">
                        <span class="material-icons">how_to_reg</span>
                        <span class="step-number">1</span>
                    </div>
                    <div class="step-content">
                        <h3>Register</h3>
                        <p>Create your account as Farmer — Farmer.</p>
                    </div>
                </div>

                <div class="step-item">
                    <div class="step-circle">
                        <span class="material-icons">add_location_alt</span>
                        <span class="step-number">2</span>
                    </div>
                    <div class="step-content">
                        <h3>Add Farm Information</h3>
                        <p>Register your farm details, land plots, soil types and GPS boundaries on the platform.</p>
                    </div>
                </div>

                <div class="step-item">
                    <div class="step-circle">
                        <span class="material-icons">event</span>
                        <span class="step-number">3</span>
                    </div>
                    <div class="step-content">
                        <h3>Plan Crops</h3>
                        <p>Create crop cycles, select varieties, set sowing schedules and expected harvest timelines.</p>
                    </div>
                </div>

                <div class="step-item">
                    <div class="step-circle">
                        <span class="material-icons">monitor_heart</span>
                        <span class="step-number">4</span>
                    </div>
                    <div class="step-content">
                        <h3>Monitor Conditions</h3>
                        <p>Track real-time soil moisture, temperature, pH, rainfall and receive automated smart alerts.</p>
                    </div>
                </div>

                <div class="step-item">
                    <div class="step-circle">
                        <span class="material-icons">agriculture</span>
                        <span class="step-number">5</span>
                    </div>
                    <div class="step-content">
                        <h3>Track Harvest</h3>
                        <p>Log your harvest records, actual yields versus forecasted, and manage post-harvest storage.</p>
                    </div>
                </div>

                <div class="step-item">
                    <div class="step-circle">
                        <span class="material-icons">sell</span>
                        <span class="step-number">6</span>
                    </div>
                    <div class="step-content">
                        <h3>Sell Produce</h3>
                        <p>List your produce in the marketplace, connect with buyers, and track sales transactions.</p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

