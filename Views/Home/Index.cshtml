                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <span class="material-icons">precision_manufacturing</span>
                        </div>
                        <div class="benefit-text">
                            <h4>Smart Farming Technology</h4>
                            <p>IoT-enabled soil sensors and weather integrations provide data-driven decision support at every stage.</p>
                        </div>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <span class="material-icons">assessment</span>
                        </div>
                        <div class="benefit-text">
                            <h4>Better Yield Prediction</h4>
                            <p>Historical crop data and sensor analytics forecast expected yields with high accuracy before harvest.</p>
                        </div>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <span class="material-icons">water</span>
                        </div>
                        <div class="benefit-text">
                            <h4>Efficient Resource Usage</h4>
                            <p>Optimized irrigation schedules, fertilizer recommendations and crop rotation reduce input costs significantly.</p>
                        </div>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <span class="material-icons">wifi_tethering</span>
                        </div>
                        <div class="benefit-text">
                            <h4>Real-Time Monitoring</h4>
                            <p>Continuous live dashboards for every field — soil health, weather, pest incidents and harvest status.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

