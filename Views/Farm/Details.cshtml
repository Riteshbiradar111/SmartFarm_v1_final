@model Smart_Farm_and_Crop_Yeild_Management_System.Models.Farm
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Farm Details";
}

<div class="row mb-4">
    <div class="col-12">
        <a href="~/Farm" class="text-success d-inline-flex align-items-center gap-1 mb-2 text-decoration-none">
            <span class="material-icons-round">arrow_back</span>
            Back to Farms
        </a>
        <h2 class="text-success">@Model.FarmName</h2>
        <p class="text-muted">Registered Farm Details &amp; Plots</p>
    </div>
</div>

<div class="row g-4">
    <!-- Farm info card -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h4 class="text-dark mb-4 fw-semibold border-bottom pb-2">Information</h4>
            <div class="mb-3">
                <label class="text-muted small d-block">Farm Name</label>
                <span class="fw-semibold text-dark">@Model.FarmName</span>
            </div>
            <div class="mb-3">
                <label class="text-muted small d-block">Village</label>
                <span class="fw-semibold text-dark">@Model.Village</span>
            </div>
            <div class="mb-3">
                <label class="text-muted small d-block">Taluka</label>
                <span class="fw-semibold text-dark">@Model.Taluka</span>
            </div>
            <div class="mb-3">
                <label class="text-muted small d-block">District / State</label>
                <span class="fw-semibold text-dark">@Model.District, @Model.State</span>
            </div>
            <div class="mb-3">
                <label class="text-muted small d-block">Pincode</label>
                <span class="fw-semibold text-dark">@Model.Pincode</span>
            </div>
            <div class="mb-3">
                <label class="text-muted small d-block">Registered Date</label>
                <span class="fw-semibold text-dark">@Model.CreatedDate.ToString("dd-MM-yyyy")</span>
            </div>
            <div class="mt-4 d-grid gap-2">
                <a href="~/Farm/Edit/@Model.FarmId" class="btn btn-outline-success rounded-3">
                    <span class="material-icons-round align-middle me-1" style="font-size: 1.1rem;">edit</span>
                    Edit Details
                </a>
            </div>
        </div>
    </div>

    <!-- Plots card -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="text-dark mb-0 fw-semibold">Mapped Plots (@Model.LandPlots.Count)</h4>
                <a href="~/LandPlot/Create?farmId=@Model.FarmId" class="btn btn-success btn-sm d-flex align-items-center gap-1 rounded-3">
                    <span class="material-icons-round" style="font-size: 1.2rem;">add</span>
                    Add Plot
                </a>
            </div>

            @if (!Model.LandPlots.Any())
            {
                <div class="text-center py-5">
                    <span class="material-icons-round text-muted" style="font-size: 3rem;">map</span>
                    <h5 class="mt-3">No Mapped Plots</h5>
                    <p class="text-muted small">You haven't mapped any land plots inside this farm property yet.</p>
                    <a href="~/LandPlot/Create?farmId=@Model.FarmId" class="btn btn-sm btn-success rounded-3 mt-2">Add First Plot</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Plot Name</th>
                                <th>Area</th>
                                <th>Soil Type</th>
                                <th>Irrigation</th>
                                <th>GPS Location</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var plot in Model.LandPlots)
                            {
                                <tr>
                                    <td class="fw-semibold text-dark">@plot.PlotName</td>
                                    <td>@plot.Area @plot.AreaUnit</td>
                                    <td>@plot.SoilType</td>
                                    <td>@plot.IrrigationType</td>
                                    <td class="small text-muted">@plot.Latitude.ToString("F4"), @plot.Longitude.ToString("F4")</td>
                                    <td class="text-end">
                                        <div class="btn-group gap-1">
                                            <a href="~/LandPlot/Details/@plot.PlotId" class="btn btn-sm btn-outline-success border-0" title="View Map &amp; Weather">
                                                <span class="material-icons-round">visibility</span>
                                            </a>
                                            <a href="~/LandPlot/Edit/@plot.PlotId" class="btn btn-sm btn-outline-primary border-0" title="Edit Plot">
                                                <span class="material-icons-round">edit</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
