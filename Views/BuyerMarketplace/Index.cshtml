@model IEnumerable<Smart_Farm_and_Crop_Yeild_Management_System.Models.CropListing>
@{
    Layout = "_BuyerLayout";
    ViewData["Title"] = "Marketplace Produce";
    var savedCropIds = ViewBag.SavedCropIds as IEnumerable<int> ?? new List<int>();
    var search = ViewBag.SearchModel as SmartFarmMVC.Models.ViewModels.MarketplaceSearchViewModel ?? new SmartFarmMVC.Models.ViewModels.MarketplaceSearchViewModel();
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="text-success mb-1">Produce Marketplace</h2>
            <p class="text-muted mb-0">Browse and buy high-quality, verified crop listings directly from farmers.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="~/Buyer/Wishlist" class="btn btn-outline-danger rounded-pill px-4">
                <span class="material-icons-round align-middle me-1">favorite</span> Wishlist
            </a>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <span class="material-icons-round align-middle me-1">check_circle</span> @TempData["SuccessMessage"]
    </div>
}

<div class="row g-4">
    <!-- SEARCH & FILTER FORM PANEL -->
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <form method="get" action="~/BuyerMarketplace" class="row g-3">
                <!-- Search keyword -->
                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark small">Crop Name</label>
                    <input type="text" name="CropName" value="@search.CropName" class="form-control rounded-3" placeholder="e.g. Wheat, Onion" />
                </div>
                <!-- Farmer Name -->
                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark small">Farmer Name</label>
                    <input type="text" name="FarmerName" value="@search.FarmerName" class="form-control rounded-3" placeholder="Search farmer name" />
                </div>
                <!-- Village location -->
                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark small">Village</label>
                    <input type="text" name="Village" value="@search.Village" class="form-control rounded-3" placeholder="Village name" />
                </div>
                <!-- Category selector -->
                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark small">Category</label>
                    <select name="Category" class="form-select rounded-3">
                        <option value="">-- All Categories --</option>
                        @if (search.Category == "Kharif")
                        {
                            <option value="Kharif" selected>Kharif Crops</option>
                        }
                        else
                        {
                            <option value="Kharif">Kharif Crops</option>
                        }
                        @if (search.Category == "Rabi")
                        {
                            <option value="Rabi" selected>Rabi Crops</option>
                        }
                        else
                        {
                            <option value="Rabi">Rabi Crops</option>
                        }
                        @if (search.Category == "Zaid")
                        {
                            <option value="Zaid" selected>Zaid Crops</option>
                        }
                        else
                        {
                            <option value="Zaid">Zaid Crops</option>
                        }
                    </select>
                </div>
                <!-- Price cap -->
                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark small">Max Price (₹)</label>
                    <input type="number" step="0.01" name="MaxPrice" value="@search.MaxPrice" class="form-control rounded-3" placeholder="Upper price limit" />
                </div>
                <!-- Min stock quantity -->
                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark small">Min Quantity</label>
                    <input type="number" step="0.01" name="MinQuantity" value="@search.MinQuantity" class="form-control rounded-3" placeholder="Min available stock" />
                </div>
                <!-- Actions -->
                <div class="col-md-6 d-flex align-items-end gap-2 justify-content-end">
                    <a href="~/BuyerMarketplace" class="btn btn-light rounded-3 px-4">Clear All</a>
                    <button type="submit" class="btn btn-success rounded-3 px-4 d-flex align-items-center gap-1">
                        <span class="material-icons-round">search</span> Apply Filters
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- PRODUCT CATALOG LISTINGS GRID -->
    <div class="col-12">
        <!-- Category Tab Buttons -->
        <div class="d-flex flex-wrap gap-2 mb-4">
            <a href="~/BuyerMarketplace" class="btn btn-sm @(string.IsNullOrEmpty(search.Category) ? "btn-success" : "btn-light text-dark") rounded-pill px-3 py-1.5">All Crops</a>
            <a href="~/BuyerMarketplace?Category=Kharif" class="btn btn-sm @(search.Category == "Kharif" ? "btn-success" : "btn-light text-dark") rounded-pill px-3 py-1.5">Kharif Crops</a>
            <a href="~/BuyerMarketplace?Category=Rabi" class="btn btn-sm @(search.Category == "Rabi" ? "btn-success" : "btn-light text-dark") rounded-pill px-3 py-1.5">Rabi Crops</a>
            <a href="~/BuyerMarketplace?Category=Zaid" class="btn btn-sm @(search.Category == "Zaid" ? "btn-success" : "btn-light text-dark") rounded-pill px-3 py-1.5">Zaid Crops</a>
        </div>

        @if (!Model.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center text-muted">
                <span class="material-icons-round text-muted mb-2" style="font-size: 3.5rem;">storefront</span>
                <p class="mb-1 fw-bold">No Crops Available</p>
                <p class="small mb-3">No active listings match your current search filters.</p>
                <a href="~/BuyerMarketplace" class="btn btn-success btn-sm rounded-pill px-4">Reset Marketplace Filters</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    bool isWishlist = savedCropIds.Contains(item.Harvest.CropCycle.CropId);

                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 product-card position-relative" style="transition: transform 0.2s ease;">

                            <!-- Wishlist Toggle overlay icon -->
                            <form asp-action="ToggleWishlist" asp-controller="BuyerMarketplace" method="post" class="position-absolute top-0 end-0 m-2" style="z-index: 10;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cropId" value="@item.Harvest.CropCycle.CropId" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" class="btn btn-white rounded-circle p-2 shadow-sm border-0 d-inline-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                    @if (isWishlist)
                                    {
                                        <span class="material-icons-round text-danger">favorite</span>
                                    }
                                    else
                                    {
                                        <span class="material-icons-round text-muted">favorite_border</span>
                                    }
                                </button>
                            </form>

                            <!-- Crop Image Frame -->
                            <div class="bg-light text-center py-5 position-relative" style="height: 150px; overflow: hidden;">
                                <img src="@(string.IsNullOrEmpty(item.ImagePath) ? "/uploads/defaults/crop.jpg" : item.ImagePath)" 
                                     class="img-fluid" 
                                     style="object-fit: cover; width: 100%; height: 100%;" 
                                     alt="@item.Harvest.CropCycle.Crop.CropName" />
                                <span class="position-absolute bottom-0 start-0 bg-success text-white badge m-2 px-2.5 py-1 rounded-pill small">Verified Yield</span>
                            </div>

                            <!-- Crop content details -->
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h5 class="text-dark fw-bold mb-0">@item.Harvest.CropCycle.Crop.CropName</h5>
                                        <span class="text-muted small">Qty: <strong>@item.AvailableQuantity @item.Unit</strong></span>
                                    </div>
                                    <span class="text-muted small d-block mb-1">Farmer: @item.Harvest.CropCycle.LandPlot.Farm.Farmer.FullName</span>
                                    <span class="text-muted small d-block mb-1">Village: @item.Harvest.CropCycle.LandPlot.Farm.Village</span>
                                    <small class="text-muted d-block">Harvest Date: @item.Harvest.HarvestDate.ToString("dd-MM-yyyy")</small>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                    <div>
                                        <span class="text-muted small d-block">Price</span>
                                        <strong class="text-success fs-5">₹@item.PricePerUnit / @item.Unit</strong>
                                    </div>
                                    <a href="~/BuyerMarketplace/Details/@item.ListingId" class="btn btn-success rounded-3 px-3 py-1.5 small fw-bold">Buy Now</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
