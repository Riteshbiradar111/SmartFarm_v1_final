@model IEnumerable<Smart_Farm_and_Crop_Yeild_Management_System.Models.Farmer>
@{
    Layout = "_BuyerLayout";
    ViewData["Title"] = "Farmer Directory";
    var savedFarmerIds = ViewBag.SavedFarmerIds as IEnumerable<int> ?? new List<int>();
}

<div class="row mb-4">
    <div class="col-12">
        <a href="~/BuyerMarketplace" class="text-success d-inline-flex align-items-center gap-1 mb-2 text-decoration-none">
            <span class="material-icons-round">arrow_back</span> Back to Marketplace
        </a>
        <h2 class="text-success">Farmer Registry Directory</h2>
        <p class="text-muted mb-0">Browse details and profiles of the registered growers supplying the cooperative.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-4">@TempData["SuccessMessage"]</div>
}

<div class="row g-4">
    @foreach (var farmer in Model)
    {
        bool isSaved = savedFarmerIds.Contains(farmer.FarmerId);

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 position-relative">

                <!-- Wishlist save button for farmer -->
                <form asp-action="ToggleWishlist" asp-controller="BuyerMarketplace" method="post" class="position-absolute top-0 end-0 m-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="farmerId" value="@farmer.FarmerId" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <button type="submit" class="btn btn-link p-0 text-decoration-none">
                        @if (isSaved)
                        {
                            <span class="material-icons-round text-danger fs-4">favorite</span>
                        }
                        else
                        {
                            <span class="material-icons-round text-muted fs-4">favorite_border</span>
                        }
                    </button>
                </form>

                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-circle" style="width: 55px; height: 55px;">
                        <span class="material-icons-round" style="font-size: 2rem;">person</span>
                    </div>
                    <div>
                        <h5 class="text-dark fw-bold mb-0">@farmer.FullName</h5>
                        <small class="text-muted">ID: #@farmer.FarmerId</small>
                    </div>
                </div>

                <div class="border-top pt-3 small text-muted">
                    <p class="mb-2 d-flex align-items-center gap-1">
                        <span class="material-icons-round font-size-sm text-success">phone</span>
                        Mobile: <strong class="text-dark">@farmer.MobileNumber</strong>
                    </p>
                    <p class="mb-2 d-flex align-items-center gap-1">
                        <span class="material-icons-round font-size-sm text-success">location_on</span>
                        Village: <strong class="text-dark">@farmer.Village</strong>
                    </p>
                    <p class="mb-2 d-flex align-items-center gap-1">
                        <span class="material-icons-round font-size-sm text-success">map</span>
                        District: <strong class="text-dark">@farmer.District, @farmer.State</strong>
                    </p>
                    <p class="mb-0 d-flex align-items-center gap-1">
                        <span class="material-icons-round font-size-sm text-success">military_tech</span>
                        Cooperative Status: <strong class="text-success">Verified Active</strong>
                    </p>
                </div>
            </div>
        </div>
    }
</div>
