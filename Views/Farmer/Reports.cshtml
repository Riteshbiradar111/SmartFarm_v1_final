@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Farm Reports";
}

<style>
    /* Print optimizations for modern screens */
    .report-metric-card {
        transition: transform 0.2s;
    }

        .report-metric-card:hover {
            transform: translateY(-3px);
        }

    /* Print stylesheet override */
    @@media print {
        #sidebar,
        .dash-sidebar,
        .dash-topbar,
        #topbar,
        #sidebarToggleBtn,
        .sidebar-toggle-btn,
        .no-print,
        .btn,
        .btn-outline-success {
            display: none !important;
        }

        .dash-main,
        #dashMain {
            margin-left: 0 !important;
            padding: 0 !important;
            width: 100% !important;
        }

        .dash-content {
            padding: 0 !important;
            margin: 0 !important;
        }

        .card {
            border: 1px solid #ddd !important;
            box-shadow: none !important;
            border-radius: 4px !important;
            page-break-inside: avoid;
            margin-bottom: 20px !important;
        }

        body {
            background-color: #fff !important;
            color: #000 !important;
            font-size: 11pt !important;
        }

        h2, h3, h4, .text-success {
            color: #1b4332 !important;
        }

        .table-responsive {
            overflow: visible !important;
        }

        table {
            width: 100% !important;
            page-break-inside: auto;
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }
    }
</style>

<div class="row mb-4 align-items-center no-print">
    <div class="col-md-8">
        <h2 class="text-success mb-1">Executive Farm Reports</h2>
        <p class="text-muted mb-0">Generate, view and download clean printouts of your farm performance summaries.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <button onclick="window.print()" class="btn btn-success rounded-3 px-4 py-2 d-inline-flex align-items-center gap-2 shadow-sm">
            <span class="material-icons-round">print</span>
            Download Report (PDF)
        </button>
    </div>
</div>

<!-- Header Block Visible only in Print -->
<div class="d-none d-print-block mb-5 border-bottom pb-3">
    <div class="row align-items-center">
        <div class="col-8">
            <h1 style="color: #1b4332; font-weight: bold; margin-bottom: 5px;">SmartFarm Agriculture Report</h1>
            <h5 class="text-muted">Farmer: @ViewData["UserName"] | Date: @DateTime.Today.ToString("dd MMMM yyyy")</h5>
        </div>
        <div class="col-4 text-end">
            <span class="material-icons-round text-success" style="font-size: 3.5rem;">eco</span>
            <div class="fw-bold text-success" style="font-size: 14px;">SmartFarm Management System</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Yield and Sales Summary Cards -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 report-metric-card h-100 border-start border-success border-4">
            <h4 class="text-success mb-3 fw-semibold d-flex align-items-center gap-2">
                <span class="material-icons-round">analytics</span>
                Yield Production Summary
            </h4>

            @if (ViewBag.YieldSummary == null || ((IEnumerable<dynamic>)ViewBag.YieldSummary).Count() == 0)
            {
                <div class="text-center py-4 text-muted small">
                    <span class="material-icons-round fs-2">scale</span>
                    <p class="mt-2 mb-0">No harvest yields recorded yet. Sowed crops must be harvested to view summaries.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Crop Type</th>
                                <th class="text-end">Total Yield Weight</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in ViewBag.YieldSummary)
                            {
                                <tr>
                                    <td class="fw-semibold text-dark">@row.CropName</td>
                                    <td class="text-end text-success fw-bold">@row.TotalYield @row.Unit</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 report-metric-card h-100 border-start border-primary border-4">
            <h4 class="text-primary mb-3 fw-semibold d-flex align-items-center gap-2">
                <span class="material-icons-round">payments</span>
                Financial Sales Revenue
            </h4>
            <div class="py-3 text-center">
                <h6 class="text-muted mb-1 text-uppercase small" style="letter-spacing: 1px;">Total Direct Revenue Generated</h6>
                <h1 class="display-4 fw-bold text-primary mb-2">₹@ViewBag.TotalSales.ToString("N2")</h1>
                <p class="text-muted small mb-0">Aggregated from marketplace produce listings with verified buyer purchases.</p>
            </div>
        </div>
    </div>

    <!-- Log Table of All Crop Cycles -->
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h4 class="text-dark mb-3 fw-semibold border-bottom pb-2">Crop Cycles History &amp; Logs</h4>

            @if (ViewBag.CyclesLog == null || ((IEnumerable<dynamic>)ViewBag.CyclesLog).Count() == 0)
            {
                <p class="text-muted small">No past or active crop cycles recorded.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Crop</th>
                                <th>Land Plot</th>
                                <th>Sowing Date</th>
                                <th>Exp. Harvest Date</th>
                                <th>Stage</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cycle in ViewBag.CyclesLog)
                            {
                                <tr>
                                    <td class="fw-semibold text-dark">@cycle.Crop.CropName</td>
                                    <td>@cycle.LandPlot.PlotName</td>
                                    <td>@cycle.SowingDate.ToString("dd-MM-yyyy")</td>
                                    <td>@cycle.ExpectedHarvestDate.ToString("dd-MM-yyyy")</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@cycle.CurrentStage</span>
                                    </td>
                                    <td>
                                        <span class="badge @(cycle.Status == "Active" ? "bg-success-subtle text-success" : cycle.Status == "Completed" ? "bg-info-subtle text-info" : "bg-danger-subtle text-danger") rounded-pill px-3">
                                            @cycle.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Active Land Plots list -->
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h4 class="text-dark mb-3 fw-semibold border-bottom pb-2">Land Plots Registry</h4>

            @if (ViewBag.PlotsList == null || ((IEnumerable<dynamic>)ViewBag.PlotsList).Count() == 0)
            {
                <p class="text-muted small">No land plots registered yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Plot Name</th>
                                <th>Plot Code</th>
                                <th>Farm</th>
                                <th>Village</th>
                                <th>Size</th>
                                <th>Soil / Irrigation</th>
                                <th>GPS Coordinates</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var plot in ViewBag.PlotsList)
                            {
                                <tr>
                                    <td class="fw-semibold text-dark">@plot.PlotName</td>
                                    <td class="font-monospace text-success small">@plot.PlotCode</td>
                                    <td class="fw-semibold">@plot.Farm.FarmName</td>
                                    <td>@plot.Farm.Village</td>
                                    <td>@plot.Area @plot.AreaUnit</td>
                                    <td>@plot.SoilType / @plot.IrrigationType</td>
                                    <td class="small text-muted font-monospace">@plot.Latitude.ToString("F4"), @plot.Longitude.ToString("F4")</td>
                                    <td>
                                        <span class="badge bg-success rounded-pill px-2">@plot.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<div class="d-none d-print-block mt-5 pt-3 text-center border-top border-light text-muted small">
    Report generated by SmartFarm System. &copy; @DateTime.Now.Year. All Rights Reserved.
</div>
