</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            console.log("Dashboard loaded - initializing weather...");

            // Find all weather cards
            const weatherCards = document.querySelectorAll('.weather-card');
            console.log(`Found ${weatherCards.length} weather cards`);

            weatherCards.forEach((card, index) => {
                // Get data from hidden div
                const dataDiv = card.querySelector('[data-farm-index]');
                if (!dataDiv) {
                    console.error(`No data div found for card ${index}`);
                    return;
                }

                const farmIndex = dataDiv.getAttribute('data-farm-index');
                const lat = parseFloat(dataDiv.getAttribute('data-farm-lat'));
                const lng = parseFloat(dataDiv.getAttribute('data-farm-lng'));
                const farmName = dataDiv.getAttribute('data-farm-name');

                console.log(`Processing farm ${farmIndex}: ${farmName} at (${lat}, ${lng})`);

                if (isNaN(lat) || isNaN(lng)) {
                    console.error(`Invalid coordinates for farm ${farmName}`);
                    document.querySelector(`.weather-loader-${farmIndex}`).innerHTML =
                        '<span class="material-icons-round text-warning">report_problem</span><p class="small text-warning mb-0">Invalid coordinates</p>';
                    return;
                }

                // Build weather API URL
                const weatherUrl = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lng}&current=temperature_2m,relative_humidity_2m,precipitation,wind_speed_10m,weather_code&daily=precipitation_probability_max&timezone=auto`;

                console.log(`Fetching weather for ${farmName}...`);

                // Fetch weather data
                fetch(weatherUrl)
                    .then(response => {
                        if(!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        console.log(`Weather data received for ${farmName}:`, data);

                        // Update temperature
                        const tempElement = document.querySelector(`.weather-temp-${farmIndex}`);
                        if (tempElement) {
                            tempElement.innerText = Math.round(data.current.temperature_2m) + "°C";
                        }

                        // Update humidity
                        const humidityElement = document.querySelector(`.weather-humidity-${farmIndex}`);
                        if (humidityElement) {
                            humidityElement.innerText = data.current.relative_humidity_2m + "%";
                        }

                        // Update wind
                        const windElement = document.querySelector(`.weather-wind-${farmIndex}`);
                        if (windElement) {
                            windElement.innerText = data.current.wind_speed_10m + " km/h";
                        }

                        // Update rain probability
                        const rainProb = (data.daily && data.daily.precipitation_probability_max) 
                            ? data.daily.precipitation_probability_max[0] 
                            : 0;
                        const rainElement = document.querySelector(`.weather-rain-${farmIndex}`);
                        if (rainElement) {
                            rainElement.innerText = rainProb + "%";
                        }

                        // Determine weather description and icon
                        const code = data.current.weather_code;
                        let desc = "Clear";
                        let icon = "wb_sunny";

                        if (code == 0) { 
                            desc = "Clear Sky"; 
                            icon = "wb_sunny"; 
                        }
                        else if (code >= 1 && code <= 3) { 
                            desc = "Partly Cloudy"; 
                            icon = "cloud_queue"; 
                        }
                        else if (code >= 61 && code <= 65) { 
                            desc = "Rainy"; 
                            icon = "umbrella"; 
                        }
                        else if (code == 95) { 
                            desc = "Thunderstorm"; 
                            icon = "flash_on"; 
                        }
                        else { 
                            desc = "Overcast"; 
                            icon = "cloud"; 
                        }

                        // Update description and icon
                        const descElement = document.querySelector(`.weather-desc-${farmIndex}`);
                        if (descElement) {
                            descElement.innerText = desc;
                        }

                        const iconElement = document.querySelector(`.weather-icon-${farmIndex}`);
                        if (iconElement) {
                            iconElement.innerText = icon;
                        }

                        // Hide loader and show content
                        const loaderElement = document.querySelector(`.weather-loader-${farmIndex}`);
                        if (loaderElement) {
                            loaderElement.classList.add("d-none");
                        }

                        const contentElement = document.querySelector(`.weather-content-${farmIndex}`);
                        if (contentElement) {
                            contentElement.classList.remove("d-none");
                        }

                        console.log(`✓ Weather updated successfully for ${farmName}`);
                    })
                    .catch(err => {
                        console.error(`✗ Weather fetch failed for ${farmName}:`, err);
                        const loaderElement = document.querySelector(`.weather-loader-${farmIndex}`);
                        if (loaderElement) {
                            loaderElement.innerHTML =
                                '<span class="material-icons-round text-warning">report_problem</span><p class="small text-warning mb-0">Weather offline</p>';
                        }
                    });
            });
        });
    </script>
}
