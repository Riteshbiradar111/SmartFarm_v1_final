@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Farmer Dashboard";
}

<!-- ===== DASHBOARD CONTENT ===== -->
<!-- 4 KPI Stats Row -->
<div class="stats-row">
    <!-- Total Farms -->
    <div class="stat-card green">
        <div class="stat-icon-wrap si-green">
            <span class="material-icons-round">home</span>
        </div>

        <div class="stat-body">
            <div class="stat-value">@ViewBag.TotalFarms</div>
            <div class="stat-label">Total Farms</div>
            <div class="stat-change up">
                <a href="~/Farm" class="text-white text-decoration-none small">Manage Farms &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Total Plots -->
    <div class="stat-card lime">
        <div class="stat-icon-wrap si-lime">
            <span class="material-icons-round">landscape</span>
        </div>
        <div class="stat-body">
            <div class="stat-value">@ViewBag.TotalPlots</div>
            <div class="stat-label">Land Plots Mapped</div>
            <div class="stat-change neutral">
                <a href="~/LandPlot" class="text-white text-decoration-none small">View Plots &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Active Crop Cycles -->
    <div class="stat-card teal">
        <div class="stat-icon-wrap si-teal">
            <span class="material-icons-round">grass</span>
        </div>
        <div class="stat-body">
            <div class="stat-value">@ViewBag.ActiveCycles</div>
            <div class="stat-label">Active Crop Cycles</div>
            <div class="stat-change up">
                <a href="~/CropCycle" class="text-white text-decoration-none small">Monitor Progress &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Marketplace listings -->
    <div class="stat-card orange">
        <div class="stat-icon-wrap si-orange">
            <span class="material-icons-round">storefront</span>
        </div>
        <div class="stat-body">
            <div class="stat-value">@ViewBag.MarketplaceListings</div>
            <div class="stat-label">Active Listings</div>
            <div class="stat-change orange">
                <a href="~/Marketplace" class="text-white text-decoration-none small">Sell Produce &rarr;</a>
            </div>
        </div>
    </div>
</div>

<!-- Weather Widgets Section -->
<div class="mt-4">
    <h4 class="text-dark mb-3 fw-semibold d-flex align-items-center gap-2">
        <span class="material-icons-round">cloud</span>
        Live Weather - Your Farms
    </h4>
    <div class="weather-scroll-container">
        <div class="weather-cards-wrapper">
            @{
                var farmsWithWeather = ViewBag.FarmsWithWeather as IEnumerable<dynamic>;
                int farmCount = 0;

                if (farmsWithWeather != null)
                {
                    farmCount = farmsWithWeather.Count();
                }

                // Debug output
                <text><!-- Debug: Farm count = @farmCount --></text>

                if (farmCount > 0)
                {
                    int farmIndex = 0;
                    foreach (var farm in farmsWithWeather)
                    {
                        if (farm != null && farm.FirstPlot != null)
                        {
                            <div class="weather-card">
                                <div class="weather-card-header">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="material-icons-round">agriculture</span>
                                        <div>
                                            <h6 class="mb-0 fw-bold">@farm.FarmName</h6>
                                            <small class="opacity-75">@farm.FirstPlot.PlotName</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="weather-card-body">
                                    <div class="weather-loader-@farmIndex text-center py-3">
                                        <div class="spinner-border spinner-border-sm text-light" role="status"></div>
                                        <p class="small mt-2 mb-0">Loading...</p>
                                    </div>
                                    <div class="weather-content-@farmIndex d-none">
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <div>
                                                <h2 class="mb-0 fw-bold weather-temp-@farmIndex">--°C</h2>
                                                <span class="small opacity-75 weather-desc-@farmIndex">--</span>
                                            </div>
                                            <span class="material-icons-round weather-icon-@farmIndex" style="font-size: 3rem;">cloud</span>
                                        </div>
                                        <div class="weather-stats">
                                            <div class="weather-stat-item">
                                                <span class="material-icons-round">water_drop</span>
                                                <div>
                                                    <div class="weather-stat-label">Humidity</div>
                                                    <div class="weather-stat-value weather-humidity-@farmIndex">--%</div>
                                                </div>
                                            </div>
                                            <div class="weather-stat-item">
                                                <span class="material-icons-round">umbrella</span>
                                                <div>
                                                    <div class="weather-stat-label">Rain</div>
                                                    <div class="weather-stat-value weather-rain-@farmIndex">--%</div>
                                                </div>
                                            </div>
                                            <div class="weather-stat-item">
                                                <span class="material-icons-round">air</span>
                                                <div>
                                                    <div class="weather-stat-label">Wind</div>
                                                    <div class="weather-stat-value weather-wind-@farmIndex">-- km/h</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Hidden data attributes for JavaScript -->
                                <div class="d-none" 
                                     data-farm-index="@farmIndex" 
                                     data-farm-lat="@farm.FirstPlot.Latitude" 
                                     data-farm-lng="@farm.FirstPlot.Longitude"
                                     data-farm-name="@farm.FarmName">
                                </div>
                            </div>
                            farmIndex++;
                        }
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        <span class="material-icons-round">info</span>
                        No farms with plots found. Please add farms and plots to see weather data.
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Main Content Grid -->
<div class="row g-4 mt-2">
    <!-- Left Column: Crop Recommendations -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h4 class="text-dark mb-4 fw-semibold d-flex align-items-center gap-2">
                    <span class="material-icons-round text-success">agriculture</span>
                    Seasonal Crop Recommendations
                </h4>

                <!-- Current Season Alert -->
                <div class="alert border-0 mb-4 shadow-sm position-relative overflow-hidden" 
                     style="background: linear-gradient(135deg, #d8f3dc 0%, #95d5b2 100%);">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div class="season-icon-badge">
                                <span class="material-icons-round">wb_sunny</span>
                            </div>
                        </div>
                        <div class="col">
                            <h5 class="text-success fw-bold mb-1">🌱 Current Season: @ViewBag.CurrentSeason</h5>
                            <p class="mb-1 fw-semibold text-dark">@ViewBag.SeasonDescription</p>
                            <p class="mb-0 small">
                                @{
                                    string seasonText = "";
                                    if (ViewBag.CurrentSeason == "Kharif")
                                    {
                                        seasonText = "Best time to plant: Rice, Cotton, Maize, Sorghum, Pearl Millet, Soybean, Groundnut";
                                    }
                                    else if (ViewBag.CurrentSeason == "Rabi")
                                    {
                                        seasonText = "Best time to plant: Wheat, Barley, Peas, Gram, Mustard, Linseed";
                                    }
                                    else
                                    {
                                        seasonText = "Best time to plant: Watermelon, Cucumber, Muskmelon, Bitter Gourd, Summer vegetables";
                                    }
                                }
                                @seasonText
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Crop Season Tabs -->
                <ul class="nav nav-pills mb-4" id="cropSeasonTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="kharif-tab" data-bs-toggle="pill" data-bs-target="#kharif" type="button" role="tab">
                            <span class="material-icons-round me-1" style="font-size: 18px; vertical-align: middle;">water_drop</span>
                            Kharif
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="rabi-tab" data-bs-toggle="pill" data-bs-target="#rabi" type="button" role="tab">
                            <span class="material-icons-round me-1" style="font-size: 18px; vertical-align: middle;">ac_unit</span>
                            Rabi
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="zaid-tab" data-bs-toggle="pill" data-bs-target="#zaid" type="button" role="tab">
                            <span class="material-icons-round me-1" style="font-size: 18px; vertical-align: middle;">local_fire_department</span>
                            Zaid
                        </button>
                    </li>
                </ul>

                <!-- Tab Content -->
