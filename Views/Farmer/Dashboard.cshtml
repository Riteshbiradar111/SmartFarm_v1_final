                            <div class="crop-season-header">
                                <h5 class="mb-1"><span class="material-icons-round me-2">water_drop</span>Kharif Crops</h5>
                                <p class="small mb-0"><strong>Season:</strong> June - October (Monsoon)</p>
                            </div>
                            <div class="crop-season-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="crop-item-card">
                                            <div class="crop-item-header">
                                                <span class="crop-emoji">🌾</span>
                                                <h6 class="mb-0">Rice</h6>
                                            </div>
                                            <div class="crop-item-details">
                                                <div class="detail-row">
                                                    <span class="detail-label">Duration:</span>
                                                    <span class="detail-value">120-150 days</span>
                                                </div>
                                                <div class="detail-row">
                                                    <span class="detail-label">NPK:</span>
                                                    <span class="detail-value">120:60:60</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="crop-item-card">
                                            <div class="crop-item-header">
                                                <span class="crop-emoji">🌿</span>
                                                <h6 class="mb-0">Cotton</h6>
                                            </div>
                                            <div class="crop-item-details">
                                                <div class="detail-row">
                                                    <span class="detail-label">Duration:</span>
                                                    <span class="detail-value">150-180 days</span>
                                                </div>
                                                <div class="detail-row">
                                                    <span class="detail-label">NPK:</span>
                                                    <span class="detail-value">120:60:60</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="crop-item-card">
                                            <div class="crop-item-header">
                                                <span class="crop-emoji">🫘</span>
                                                <h6 class="mb-0">Soybean</h6>
                                            </div>
                                            <div class="crop-item-details">
                                                <div class="detail-row">
                                                    <span class="detail-label">Duration:</span>
                                                    <span class="detail-value">90-100 days</span>
                                                </div>
                                                <div class="detail-row">
                                                    <span class="detail-label">NPK:</span>
                                                    <span class="detail-value">30:60:40</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="crop-item-card">
                                            <div class="crop-item-header">
                                                <span class="crop-emoji">🌽</span>
                                                <h6 class="mb-0">Maize</h6>
                                            </div>
                                            <div class="crop-item-details">
                                                <div class="detail-row">
                                                    <span class="detail-label">Duration:</span>
                                                    <span class="detail-value">80-110 days</span>
                                                </div>
                                                <div class="detail-row">
                                                    <span class="detail-label">NPK:</span>
                                                    <span class="detail-value">120:60:40</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="season-conditions mt-3">
                                    <div class="condition-badge">💧 High rainfall dependency</div>
                                    <div class="condition-badge">🌡️ 25-35°C</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Rabi Tab -->
                    <div class="tab-pane fade" id="rabi" role="tabpanel">
                        <div class="crop-season-card rabi-theme">
                            <div class="crop-season-header">
                                <h5 class="mb-1"><span class="material-icons-round me-2">ac_unit</span>Rabi Crops</h5>
                                <p class="small mb-0"><strong>Season:</strong> November - February (Winter)</p>
                            </div>
                            <div class="crop-season-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="crop-item-card">
                                            <div class="crop-item-header">
                                                <span class="crop-emoji">🌾</span>
                                                <h6 class="mb-0">Wheat</h6>
                                            </div>
                                            <div class="crop-item-details">
                                                <div class="detail-row">
                                                    <span class="detail-label">Duration:</span>
                                                    <span class="detail-value">120-150 days</span>
                                                </div>
                                                <div class="detail-row">
                                                    <span class="detail-label">NPK:</span>
                                                    <span class="detail-value">120:60:40</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="crop-item-card">
                                            <div class="crop-item-header">
                                                <span class="crop-emoji">🌻</span>
                                                <h6 class="mb-0">Mustard</h6>
                                            </div>
                                            <div class="crop-item-details">
                                                <div class="detail-row">
                                                    <span class="detail-label">Duration:</span>
                                                    <span class="detail-value">90-110 days</span>
                                                </div>
                                                <div class="detail-row">
                                                    <span class="detail-label">NPK:</span>
                                                    <span class="detail-value">60:40:20</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="crop-item-card">
                                            <div class="crop-item-header">
                                                <span class="crop-emoji">🫛</span>
                                                <h6 class="mb-0">Gram</h6>
                                            </div>
                                            <div class="crop-item-details">
                                                <div class="detail-row">
                                                    <span class="detail-label">Duration:</span>
                                                    <span class="detail-value">100-120 days</span>
                                                </div>
                                                <div class="detail-row">
                                                    <span class="detail-label">NPK:</span>
                                                    <span class="detail-value">20:40:20</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="crop-item-card">
                                            <div class="crop-item-header">
                                                <span class="crop-emoji">🌾</span>
                                                <h6 class="mb-0">Barley</h6>
                                            </div>
                                            <div class="crop-item-details">
                                                <div class="detail-row">
                                                    <span class="detail-label">Duration:</span>
                                                    <span class="detail-value">120-140 days</span>
                                                </div>
                                                <div class="detail-row">
                                                    <span class="detail-label">NPK:</span>
                                                    <span class="detail-value">80:40:20</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="season-conditions mt-3">
                                    <div class="condition-badge">💧 Irrigation required</div>
                                    <div class="condition-badge">🌡️ 15-25°C</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Zaid Tab -->
                    <div class="tab-pane fade" id="zaid" role="tabpanel">
                        <div class="crop-season-card zaid-theme">
                            <div class="crop-season-header">
                                <h5 class="mb-1"><span class="material-icons-round me-2">local_fire_department</span>Zaid Crops</h5>
                                <p class="small mb-0"><strong>Season:</strong> March - May (Summer)</p>
                            </div>
                            <div class="crop-season-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="crop-item-card">
                                            <div class="crop-item-header">
                                                <span class="crop-emoji">🍉</span>
                                                <h6 class="mb-0">Watermelon</h6>
                                            </div>
                                            <div class="crop-item-details">
                                                <div class="detail-row">
                                                    <span class="detail-label">Duration:</span>
                                                    <span class="detail-value">70-90 days</span>
                                                </div>
                                                <div class="detail-row">
                                                    <span class="detail-label">NPK:</span>
                                                    <span class="detail-value">100:50:50</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="crop-item-card">
                                            <div class="crop-item-header">
                                                <span class="crop-emoji">🍈</span>
                                                <h6 class="mb-0">Muskmelon</h6>
                                            </div>
                                            <div class="crop-item-details">
                                                <div class="detail-row">
                                                    <span class="detail-label">Duration:</span>
                                                    <span class="detail-value">65-80 days</span>
                                                </div>
                                                <div class="detail-row">
                                                    <span class="detail-label">NPK:</span>
                                                    <span class="detail-value">90:45:45</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="crop-item-card">
                                            <div class="crop-item-header">
                                                <span class="crop-emoji">🥒</span>
                                                <h6 class="mb-0">Cucumber</h6>
                                            </div>
                                            <div class="crop-item-details">
                                                <div class="detail-row">
                                                    <span class="detail-label">Duration:</span>
                                                    <span class="detail-value">50-70 days</span>
                                                </div>
                                                <div class="detail-row">
                                                    <span class="detail-label">NPK:</span>
                                                    <span class="detail-value">80:40:40</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="crop-item-card">
                                            <div class="crop-item-header">
                                                <span class="crop-emoji">🎃</span>
                                                <h6 class="mb-0">Pumpkin</h6>
                                            </div>
                                            <div class="crop-item-details">
                                                <div class="detail-row">
                                                    <span class="detail-label">Duration:</span>
                                                    <span class="detail-value">90-120 days</span>
                                                </div>
                                                <div class="detail-row">
                                                    <span class="detail-label">NPK:</span>
                                                    <span class="detail-value">50:25:25</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="season-conditions mt-3">
                                    <div class="condition-badge">💧 Frequent irrigation needed</div>
                                    <div class="condition-badge">🌡️ 30-40°C</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Fertilizer Guide -->
                <div class="fertilizer-guide-card mt-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="material-icons-round text-primary">science</span>
                        <h6 class="mb-0 fw-bold">Fertilizer Application Guide</h6>
                    </div>
                    <p class="small mb-2"><strong>NPK Format:</strong> Nitrogen:Phosphorus:Potassium (kg/hectare)</p>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <div class="fertilizer-tip">
                                <strong>Basal Dose:</strong> 50% N + full P & K at sowing
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="fertilizer-tip">
                                <strong>Top Dressing:</strong> Remaining 50% N in 2 splits
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="fertilizer-tip">
                                <strong>Organic:</strong> 10-15 tonnes FYM/hectare
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="fertilizer-tip">
                                <strong>Micronutrients:</strong> Based on soil test
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Notifications -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h5 class="card-title d-flex align-items-center gap-2 mb-4">
                    <span class="material-icons-round text-primary">notifications</span>
                    Recent Notifications
                </h5>
                <div class="notifications-list">
                    @foreach (var notif in ViewBag.RecentNotifications as IEnumerable<Smart_Farm_and_Crop_Yeild_Management_System.Models.Notification>)
                    {
                        <div class="notification-item">
                            <div class="notification-icon">
                                <span class="material-icons-round">campaign</span>
                            </div>
                            <div class="notification-content">
                                <h6 class="notification-title">@notif.Title</h6>
                                <p class="notification-message">@notif.Message</p>
                                <small class="notification-time">@notif.CreatedDate.ToString("dd MMM, HH:mm")</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* Weather Cards Styling */
.weather-scroll-container {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: #52b788 #f1f3f5;
}

.weather-scroll-container::-webkit-scrollbar {
    height: 8px;
}

.weather-scroll-container::-webkit-scrollbar-track {
    background: #f1f3f5;
    border-radius: 10px;
}

.weather-scroll-container::-webkit-scrollbar-thumb {
    background: #52b788;
    border-radius: 10px;
}

.weather-cards-wrapper {
    display: flex;
    gap: 1rem;
    padding-bottom: 1rem;
}

.weather-card {
    min-width: 320px;
    background: linear-gradient(135deg, #1b4332 0%, #2d6a4f 100%);
    border-radius: 16px;
    color: white;
    box-shadow: 0 8px 24px rgba(27, 67, 50, 0.3);
    transition: transform 0.3s ease;
}

.weather-card:hover {
    transform: translateY(-5px);
}

.weather-card-header {
    padding: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.weather-card-body {
    padding: 1.25rem;
}

.weather-stats {
    display: flex;
    gap: 0.75rem;
    flex-direction: column;
}

.weather-stat-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
}

.weather-stat-item .material-icons-round {
    font-size: 24px;
    opacity: 0.8;
}

.weather-stat-label {
    font-size: 0.75rem;
    opacity: 0.75;
}

.weather-stat-value {
    font-size: 1rem;
    font-weight: 600;
}

/* Season Icon Badge */
.season-icon-badge {
    width: 64px;
    height: 64px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
