	// Auto-submit form when filters change or Enter key pressed in search
	$(document).ready(function() {
		// Submit form when dropdowns change
		$('select[name="roleFilter"], select[name="statusFilter"]').on('change', function() {
			$('#filterForm').submit();
		});

		// Submit form when Enter key is pressed in search box
		$('#searchInput').on('keypress', function(e) {
			if (e.which === 13) { // Enter key
				e.preventDefault();
				$('#filterForm').submit();
			}
		});
	});
