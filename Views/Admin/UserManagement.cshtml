@model Smart_Farm_and_Crop_Yeild_Management_System.Models.ViewModels.UserManagementViewModel
@{
	Layout = "_DashboardLayout";
	ViewData["Title"] = "User Management";
}

<!-- ===== MAIN CONTENT ===== -->
<div class="dash-content">

	<!-- Page Header with Add User Button -->
	<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
		<div>
			<h1 style="font-size: 24px; font-weight: 600; color: #1a1a1a; margin: 0;">User Management</h1>
			<p style="color: #7a9a8a; font-size: 14px; margin: 4px 0 0 0;">Manage all Smartfarm users.</p>
		</div>
		<button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createUserModal" style="background: #2D6A4F; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 500;">
			<i class="fas fa-plus" style="margin-right: 6px;"></i> Add User
		</button>
	</div>

	<!-- Statistics Cards Row -->
	<div class="stats-row" style="margin-bottom: 24px;">
		<div class="stat-card" style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
			<div style="display: flex; align-items: center; gap: 16px;">
				<div style="width: 48px; height: 48px; background: #e8f5e9; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
					<i class="fas fa-users" style="color: #2D6A4F; font-size: 24px;"></i>
				</div>
				<div>
					<div style="font-size: 14px; color: #7a9a8a; margin-bottom: 4px;">TOTAL USERS</div>
					<div style="font-size: 28px; font-weight: 700; color: #1a1a1a;">@Model.TotalUsers</div>
				</div>
			</div>
		</div>

		<div class="stat-card" style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
			<div style="display: flex; align-items: center; gap: 16px;">
				<div style="width: 48px; height: 48px; background: #e3f2fd; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
					<i class="fas fa-user-check" style="color: #1976d2; font-size: 24px;"></i>
				</div>
				<div>
					<div style="font-size: 14px; color: #7a9a8a; margin-bottom: 4px;">ACTIVE USERS</div>
					<div style="font-size: 28px; font-weight: 700; color: #1a1a1a;">@Model.ActiveUsers</div>
				</div>
			</div>
		</div>

		<div class="stat-card" style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
			<div style="display: flex; align-items: center; gap: 16px;">
				<div style="width: 48px; height: 48px; background: #fff3e0; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
					<i class="fas fa-hourglass-half" style="color: #f57c00; font-size: 24px;"></i>
				</div>
				<div>
					<div style="font-size: 14px; color: #7a9a8a; margin-bottom: 4px;">PENDING APPROVAL</div>
					<div style="font-size: 28px; font-weight: 700; color: #1a1a1a;">@Model.PendingApproval</div>
				</div>
			</div>
		</div>

		<div class="stat-card" style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
			<div style="display: flex; align-items: center; gap: 16px;">
				<div style="width: 48px; height: 48px; background: #ffebee; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
					<i class="fas fa-user-times" style="color: #c62828; font-size: 24px;"></i>
				</div>
				<div>
					<div style="font-size: 14px; color: #7a9a8a; margin-bottom: 4px;">BLOCKED USERS</div>
					<div style="font-size: 28px; font-weight: 700; color: #1a1a1a;">@Model.BlockedUsers</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Search and Filters -->
	<div class="dash-card" style="margin-bottom: 0;">
		<div class="dash-card-body">
			<form method="get" asp-action="UserManagement" id="filterForm">
				<div style="display: flex; gap: 12px; align-items: center; margin-bottom: 24px;">
					<!-- Search Box -->
					<div style="flex: 1; position: relative;">
						<i class="fas fa-search" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #7a9a8a;"></i>
						<input type="text" 
							   id="searchInput"
							   name="searchTerm" 
							   value="@Model.SearchTerm" 
							   placeholder="Search users by name, email or phone" 
							   style="width: 100%; padding: 10px 14px 10px 40px; border: 1px solid #e2ede8; border-radius: 8px; font-size: 14px;" />
					</div>

					<!-- Search Button -->
					<button type="submit" 
							style="padding: 10px 20px; background: #2D6A4F; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 500;">
						<i class="fas fa-search"></i> Search
					</button>

					<!-- Role Filter -->
					<select name="roleFilter" 
							style="padding: 10px 14px; border: 1px solid #e2ede8; border-radius: 8px; font-size: 14px; min-width: 150px;">
						<option value="">All Roles</option>
						<option value="Farmer" selected="@(Model.RoleFilter == "Farmer")">Farmer</option>
						<option value="Agronomist" selected="@(Model.RoleFilter == "Agronomist")">Agronomist</option>
						<option value="Field Officer" selected="@(Model.RoleFilter == "Field Officer")">Field Officer</option>
						<option value="Cooperative Manager" selected="@(Model.RoleFilter == "Cooperative Manager")">Coop Manager</option>
						<option value="Buyer" selected="@(Model.RoleFilter == "Buyer")">Buyer</option>
						<option value="Admin" selected="@(Model.RoleFilter == "Admin")">Admin</option>
					</select>

					<!-- Status Filter -->
					<select name="statusFilter" 
							style="padding: 10px 14px; border: 1px solid #e2ede8; border-radius: 8px; font-size: 14px; min-width: 150px;">
						<option value="">All Status</option>
						<option value="ACTIVE" selected="@(Model.StatusFilter == "ACTIVE")">Active</option>
						<option value="PENDING" selected="@(Model.StatusFilter == " PENDING")">Pending</option>
						<option value="BLOCKED" selected="@(Model.StatusFilter == "BLOCKED")">Blocked</option>
					</select>

					<!-- Refresh Button -->
					<button type="button" 
					onclick="location.reload()" 
					style="padding: 10px 14px; background: white; border: 1px solid #e2ede8; border-radius: 8px; cursor: pointer;">
						<i class="fas fa-sync-alt"></i>
					</button>
				</div>
			</form>

			<!-- Users Table with Fixed Height and Internal Scroll -->
			<div class="user-table-container">
				<table class="table" style="width: 100%; border-collapse: collapse;">
					<thead>
				   <tr style="background: #f8faf9; border-bottom: 2px solid #e2ede8;">
							<th style="padding: 14px 16px; text-align: left; font-weight: 600; font-size: 12px; color: #7a9a8a; text-transform: uppercase;">Profile</th>
							<th style="padding: 14px 16px; text-align: left; font-weight: 600; font-size: 12px; color: #7a9a8a; text-transform: uppercase;">Name</th>
							<th style="padding: 14px 16px; text-align: left; font-weight: 600; font-size: 12px; color: #7a9a8a; text-transform: uppercase;">Email</th>
							<th style="padding: 14px 16px; text-align: left; font-weight: 600; font-size: 12px; color: #7a9a8a; text-transform: uppercase;">Phone</th>
							<th style="padding: 14px 16px; text-align: left; font-weight: 600; font-size: 12px; color: #7a9a8a; text-transform: uppercase;">Role</th>
							<th style="padding: 14px 16px; text-align: left; font-weight: 600; font-size: 12px; color: #7a9a8a; text-transform: uppercase;">Status</th>
							<th style="padding: 14px 16px; text-align: left; font-weight: 600; font-size: 12px; color: #7a9a8a; text-transform: uppercase;">Join Date</th>
							<th style="padding: 14px 16px; text-align: left; font-weight: 600; font-size: 12px; color: #7a9a8a; text-transform: uppercase;">Assigned Field Officer</th>
							<th style="padding: 14px 16px; text-align: left; font-weight: 600; font-size: 12px; color: #7a9a8a; text-transform: uppercase;">Assigned Agronomist</th>
							<th style="padding: 14px 16px; text-align: center; font-weight: 600; font-size: 12px; color: #7a9a8a; text-transform: uppercase;">Actions</th>
						</tr>
					</thead>
					<tbody>
						@if (Model.Users.Any())
						{
							@foreach (var user in Model.Users)
							{
								<tr style="border-bottom: 1px solid #f0f7f4;">
									<td style="padding: 16px;">
										<div style="width: 40px; height: 40px; border-radius: 50%; background: #2D6A4F; color: white; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 14px;">
											@user.ProfileInitials
										</div>
									</td>
									<td style="padding: 16px;">
										<div style="font-weight: 600; color: #1a1a1a; margin-bottom: 2px;">@user.FullName</div>
										<div style="font-size: 13px; color: #7a9a8a;">@user.Username</div>
									</td>
									<td style="padding: 16px; color: #1a1a1a;">@user.Email</td>
									<td style="padding: 16px; color: #1a1a1a;">@(user.Phone ?? "-")</td>
									<td style="padding: 16px;">
										<span class="@user.RoleBadgeClass">@user.RoleName</span>
									</td>
									<td style="padding: 16px;">
										<span class="@user.StatusBadgeClass">@user.Status</span>
									</td>
									<td style="padding: 16px; color: #7a9a8a; font-size: 13px;">@user.JoinDateFormatted</td>
									<td style="padding: 16px; color: #1a1a1a;">@user.AssignedFieldOfficer</td>
									<td style="padding: 16px; color: #1a1a1a;">@user.AssignedAgronomist</td>
									<td style="padding: 16px; text-align: center;">
										<div style="display: flex; gap: 8px; justify-content: center;">
											<button class="btn-icon" title="View" onclick="viewUser(@user.UserId)"><i class="fas fa-eye" style="color: #1976d2;"></i></button>
											<button class="btn-icon" title="Edit" onclick="editUser(@user.UserId)"><i class="fas fa-edit" style="color: #f57c00;"></i></button>
											@if (user.Status == "PENDING")
											{
												<button class="btn-icon" title="Approve" onclick="approveUser(@user.UserId)"><i class="fas fa-check" style="color: #2e7d32;"></i></button>
											}
											else if (user.Status == "BLOCKED")
											{
												<button class="btn-icon" title="Unblock" onclick="unblockUser(@user.UserId)"><i class="fas fa-unlock" style="color: #2e7d32;"></i></button>
											}
											else if (user.Status == "ACTIVE" && (user.RoleName == "Field Officer" || user.RoleName == "Agronomist" || user.RoleName == "Cooperative Manager"))
											{
												<button class="btn-icon" title="Block" onclick="blockUser(@user.UserId)"><i class="fas fa-ban" style="color: #c62828;"></i></button>
											}
											<button class="btn-icon" title="Delete" onclick="deleteUser(@user.UserId)"><i class="fas fa-trash" style="color: #c62828;"></i></button>
										</div>
									</td>
								</tr>
							}
						}
						else
						{
							<tr>
								<td colspan="10" style="padding: 40px; text-align: center; color: #7a9a8a;">
									No users found.
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>

</div>

<style>
	/* Fixed Height Scrollable Table Container */
	.user-table-container {
		max-height: 600px;
		overflow-y: auto;
		overflow-x: auto;
		border: 1px solid #e2ede8;
		border-radius: 8px;
	}

	/* Sticky Table Header */
	.user-table-container table thead {
		position: sticky;
		top: 0;
		z-index: 10;
		background: #f8faf9;
	}

	/* Custom Scrollbar Styling */
	.user-table-container::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}

	.user-table-container::-webkit-scrollbar-track {
		background: #f0f7f4;
		border-radius: 4px;
	}

	.user-table-container::-webkit-scrollbar-thumb {
		background: #2D6A4F;
		border-radius: 4px;
	}

	.user-table-container::-webkit-scrollbar-thumb:hover {
		background: #1f4d37;
	}

	.badge {
		padding: 6px 12px;
		border-radius: 6px;
		font-size: 11px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		display: inline-block;
	}

	.badge-green {
		background: #e8f5e9;
		color: #2e7d32;
	}

	.badge-yellow {
		background: #fff3e0;
		color: #e65100;
	}

	.badge-blue {
		background: #e3f2fd;
		color: #1976d2;
	}

	.badge-cyan {
		background: #e0f7fa;
		color: #00838f;
	}

	.badge-purple {
		background: #f3e5f5;
		color: #6a1b9a;
	}

	.badge-orange {
		background: #fff3e0;
		color: #e65100;
	}

	.badge-red {
		background: #ffebee;
		color: #c62828;
	}

	.btn-icon {
		background: none;
		border: none;
		cursor: pointer;
		padding: 6px;
		border-radius: 4px;
		transition: background 0.2s;
	}

	.btn-icon:hover {
		background: #f0f7f4;
	}

	.stats-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 20px;
	}

	.dash-card {
		background: white;
		border-radius: 12px;
		box-shadow: 0 2px 8px rgba(0,0,0,0.08);
	}

	.dash-card-body {
		padding: 24px;
	}

	table tbody tr:hover {
		background: #f8faf9;
	}
</style>

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<!-- Create User Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Add New User</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<form id="createUserForm">
					<div class="mb-3">
						<label class="form-label">Username *</label>
						<input type="text" class="form-control" id="create_username" required />
					</div>
					<div class="mb-3">
						<label class="form-label">Full Name *</label>
						<input type="text" class="form-control" id="create_fullname" required />
					</div>
					<div class="mb-3">
						<label class="form-label">Email *</label>
						<input type="email" class="form-control" id="create_email" required />
					</div>
					<div class="mb-3">
						<label class="form-label">Password *</label>
						<input type="password" class="form-control" id="create_password" required minlength="6" />
					</div>
					<div class="mb-3">
						<label class="form-label">Phone</label>
						<input type="text" class="form-control" id="create_phone" />
					</div>
					<div class="mb-3">
						<label class="form-label">Role *</label>
						<select class="form-control" id="create_roleId" required>
							<option value="">Select Role</option>
							<option value="1">Admin</option>
							<option value="2">Farmer</option>
							<option value="3">Agronomist</option>
							<option value="4">Field Officer</option>
							<option value="5">Cooperative Manager</option>
							<option value="6">Buyer</option>
						</select>
					</div>
				</form>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-primary" onclick="submitCreateUser()" style="background: #2D6A4F; border: none;">Create User</button>
			</div>
		</div>
	</div>
</div>

<!-- View User Modal -->
<div class="modal fade" id="viewUserModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">User Details</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body" id="viewUserContent">
				<!-- User details will be loaded here -->
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
			</div>
		</div>
	</div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Edit User</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<form id="editUserForm">
					<input type="hidden" id="edit_userId" />
					<div class="mb-3">
						<label class="form-label">Username *</label>
						<input type="text" class="form-control" id="edit_username" required />
					</div>
					<div class="mb-3">
						<label class="form-label">Full Name *</label>
						<input type="text" class="form-control" id="edit_fullname" required />
					</div>
					<div class="mb-3">
						<label class="form-label">Email *</label>
						<input type="email" class="form-control" id="edit_email" required />
					</div>
					<div class="mb-3">
						<label class="form-label">Phone</label>
						<input type="text" class="form-control" id="edit_phone" />
					</div>
					<div class="mb-3">
						<label class="form-label">Role *</label>
						<select class="form-control" id="edit_roleId" required>
						</select>
					</div>
					<div class="mb-3 form-check">
						<input type="checkbox" class="form-check-input" id="edit_isActive" />
						<label class="form-check-label" for="edit_isActive">Active</label>
					</div>
				</form>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-primary" onclick="submitEditUser()" style="background: #2D6A4F; border: none;">Save Changes</button>
			</div>
		</div>
	</div>
</div>

@section Scripts {
<script>
	// Toast Notification Helper
	function showToast(message, type = 'success') {
		const toastEl = document.getElementById('liveToast');
		const toastBody = document.getElementById('toastMessage');

		// Set message
		toastBody.textContent = message;

		// Set color based on type
		toastEl.classList.remove('text-bg-success', 'text-bg-danger', 'text-bg-warning', 'text-bg-info');
		if (type === 'success') {
			toastEl.classList.add('text-bg-success');
		} else if (type === 'error') {
			toastEl.classList.add('text-bg-danger');
		} else if (type === 'warning') {
			toastEl.classList.add('text-bg-warning');
		} else {
			toastEl.classList.add('text-bg-info');
		}

		// Show toast
		const toast = new bootstrap.Toast(toastEl);
		toast.show();
	}

	// Load roles dynamically on page load
	$(document).ready(function() {
		loadRolesForCreate();
	});

	function loadRolesForCreate() {
		$.ajax({
			url: '@Url.Action("GetRoles", "Admin")',
			type: 'GET',
			success: function(response) {
				if (response.success) {
					const select = $('#create_roleId');
					select.empty();
					select.append('<option value="">Select Role</option>');
					response.roles.forEach(function(role) {
						select.append(`<option value="${role.roleId}">${role.roleName}</option>`);
					});
				}
			},
			error: function() {
				console.error('Failed to load roles');
			}
		});
	}

	// Create User
	function submitCreateUser() {
		const formData = {
			Username: $('#create_username').val(),
			FullName: $('#create_fullname').val(),
			Email: $('#create_email').val(),
			Password: $('#create_password').val(),
			Phone: $('#create_phone').val(),
			RoleId: parseInt($('#create_roleId').val())
		};

		$.ajax({
			url: '@Url.Action("CreateUser", "Admin")',
			type: 'POST',
			contentType: 'application/json',
			data: JSON.stringify(formData),
			success: function(response) {
				if (response.success) {
					showToast(response.message, 'success');
					$('#createUserModal').modal('hide');
					$('#createUserForm')[0].reset();
					setTimeout(function() {
						location.reload();
					}, 1000);
				} else {
					showToast(response.message, 'error');
				}
			},
			error: function(xhr) {
				if (xhr.responseJSON && xhr.responseJSON.message) {
					showToast(xhr.responseJSON.message, 'error');
				} else {
					showToast('Error creating user. Please try again.', 'error');
				}
			}
		});
	}

	// View User
	function viewUser(userId) {
		$.ajax({
			url: '@Url.Action("ViewUser", "Admin")/' + userId,
			type: 'GET',
			success: function(response) {
				if (response.success) {
					const user = response.user;
					const html = `
						<div class="row">
							<div class="col-md-6 mb-3">
								<strong>Username:</strong><br/>${user.username}
							</div>
							<div class="col-md-6 mb-3">
								<strong>Full Name:</strong><br/>${user.fullName}
							</div>
							<div class="col-md-6 mb-3">
								<strong>Email:</strong><br/>${user.email}
							</div>
							<div class="col-md-6 mb-3">
								<strong>Phone:</strong><br/>${user.phone}
							</div>
							<div class="col-md-6 mb-3">
								<strong>Role:</strong><br/>${user.roleName}
							</div>
							<div class="col-md-6 mb-3">
								<strong>Status:</strong><br/><span class="badge ${user.status === 'ACTIVE' ? 'bg-success' : 'bg-warning'}">${user.status}</span>
							</div>
							<div class="col-md-6 mb-3">
								<strong>Join Date:</strong><br/>${user.joinDate}
							</div>
							<div class="col-md-6 mb-3">
								<strong>Last Login:</strong><br/>${user.lastLogin}
							</div>
						</div>
					`;
					$('#viewUserContent').html(html);
					$('#viewUserModal').modal('show');
				} else {
					showToast(response.message, 'error');
				}
			},
			error: function() {
				showToast('Error loading user details.', 'error');
			}
		});
	}

	// Edit User
	function editUser(userId) {
		$.ajax({
			url: '@Url.Action("EditUser", "Admin")/' + userId,
			type: 'GET',
			success: function(response) {
				if (response.success) {
					const user = response.user;
					$('#edit_userId').val(user.userId);
					$('#edit_username').val(user.username);
					$('#edit_fullname').val(user.fullName);
					$('#edit_email').val(user.email);
					$('#edit_phone').val(user.phone);
					$('#edit_isActive').prop('checked', user.isActive);

					// Populate roles dropdown
					$('#edit_roleId').empty();
					user.roles.forEach(function(role) {
						$('#edit_roleId').append(`<option value="${role.id}" ${role.id === user.roleId ? 'selected' : ''}>${role.name}</option>`);
					});

								$('#editUserModal').modal('show');
							} else {
								showToast(response.message, 'error');
							}
						},
						error: function() {
							showToast('Error loading user details.', 'error');
						}
					});
	}

	function submitEditUser() {
		const formData = {
			UserId: parseInt($('#edit_userId').val()),
			Username: $('#edit_username').val(),
			FullName: $('#edit_fullname').val(),
			Email: $('#edit_email').val(),
			Phone: $('#edit_phone').val(),
			RoleId: parseInt($('#edit_roleId').val()),
			IsActive: $('#edit_isActive').is(':checked')
		};

		$.ajax({
			url: '@Url.Action("EditUser", "Admin")',
			type: 'POST',
			contentType: 'application/json',
			data: JSON.stringify(formData),
				success: function(response) {
					if (response.success) {
						showToast(response.message, 'success');
						$('#editUserModal').modal('hide');
						setTimeout(function() {
							location.reload();
						}, 1000);
					} else {
						showToast(response.message, 'error');
					}
				},
				error: function(xhr) {
					if (xhr.responseJSON && xhr.responseJSON.message) {
						showToast(xhr.responseJSON.message, 'error');
					} else {
						showToast('Error updating user.', 'error');
					}
				}
			});
	}

