@model IEnumerable<Smart_Farm_and_Crop_Yeild_Management_System.Models.CropListing>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Produce Sales";
    var userRole = ViewData["UserRole"] as string ?? "";
    var buyerOrders = ViewBag.BuyerOrders as IEnumerable<Smart_Farm_and_Crop_Yeild_Management_System.Models.CropOrder> ?? new List<Smart_Farm_and_Crop_Yeild_Management_System.Models.CropOrder>();

    var activeIncomingOrders = buyerOrders.Where(o => o.Status == "Pending" || o.Status == "Request Sent" || o.Status == "PENDING_FARMER_ACCEPTANCE" || o.Status == "REQUESTED" || o.Status == "Accepted" || o.Status == "Farmer Accepted" || o.Status == "ACCEPTED" || o.Status == "Paid" || o.Status == "Preparing Produce" || o.Status == "Ready for Pickup" || o.Status == "In Transit").ToList();

    var closedHistoryOrders = buyerOrders.Where(o => o.Status == "Delivered" || o.Status == "Completed" || o.Status == "Declined" || o.Status == "Rejected" || o.Status == "Cancelled").ToList();
}

<div class="row">
    <div class="col-12 d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="mb-1 text-success">Produce Sales Manager</h2>
            <p class="text-muted mb-0">Publish warehouse stock, review incoming B2B buyer requests, and track shipping stages.</p>
        </div>
        @if (userRole == "Farmer")
        {
            <a href="~/Marketplace/Create" class="btn btn-success d-flex align-items-center gap-2 rounded-pill px-4 shadow-sm">
                <span class="material-icons-round">storefront</span>
                List Produce for Sale
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <span class="material-icons-round align-middle me-1">check_circle</span> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <span class="material-icons-round align-middle me-1">error</span> @TempData["ErrorMessage"]
    </div>
}

<!-- Tab Headers -->
<ul class="nav nav-tabs border-bottom mb-4" id="salesTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold text-dark" id="listings-tab" data-bs-toggle="tab" data-bs-target="#listings-pane" type="button" role="tab" aria-controls="listings-pane" aria-selected="true">
            My Crop Listings (@Model.Count())
        </button>
    </li>
    @if (userRole == "Farmer")
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-dark" id="active-orders-tab" data-bs-toggle="tab" data-bs-target="#active-orders-pane" type="button" role="tab" aria-controls="active-orders-pane" aria-selected="false">
                Incoming & Active Orders (@activeIncomingOrders.Count())
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-dark" id="history-orders-tab" data-bs-toggle="tab" data-bs-target="#history-orders-pane" type="button" role="tab" aria-controls="history-orders-pane" aria-selected="false">
                Order History (@closedHistoryOrders.Count())
            </button>
        </li>
    }
</ul>

<div class="tab-content" id="salesTabsContent">
    <!-- 1. Active Listings Tab -->
    <div class="tab-pane fade show active" id="listings-pane" role="tabpanel" aria-labelledby="listings-tab">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <span class="material-icons-round text-muted" style="font-size: 3rem;">storefront</span>
                        <p class="mb-0 mt-2 fw-semibold">No Listings Found</p>
                        <p class="small">You haven't listed any harvests on the marketplace yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 text-dark">
                            <thead class="table-light text-muted small">
                                <tr>
                                    <th class="ps-4">Listed Date</th>
                                    <th>Crop Type</th>
                                    <th>Original Stock</th>
                                    <th>Sold Quantity</th>
                                    <th>Remaining Stock</th>
                                    <th>Price per Unit</th>
                                    <th>Status</th>
                                    <th>Action / Buyer</th>
                                    <th class="pe-4 text-end">Listing ID</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    decimal origQty = item.OriginalQuantity ?? item.AvailableQuantity;
                                    decimal soldQty = origQty - item.AvailableQuantity;

                                    <tr>
                                        <td class="ps-4 text-muted small">@item.ListedDate.ToString("dd-MM-yyyy")</td>
                                        <td class="fw-bold text-success">@item.Harvest.CropCycle.Crop.CropName</td>
                                        <td class="fw-semibold">@origQty.ToString("0.00") @item.Unit</td>
                                        <td class="fw-semibold text-primary">@soldQty.ToString("0.00") @item.Unit</td>
                                        <td class="fw-bold @(item.AvailableQuantity > 0 ? "text-success" : "text-danger")">@item.AvailableQuantity.ToString("0.00") @item.Unit</td>
                                        <td class="fw-semibold">₹@item.PricePerUnit.ToString("0.00") / @item.Unit</td>
                                        <td>
                                            <span class="badge @(item.Status == "Available" && item.AvailableQuantity > 0 ? "bg-success" : "bg-danger") rounded-pill px-2.5 py-1">
                                                @(item.Status == "Available" && item.AvailableQuantity > 0 ? "Available" : "Sold Out")
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.Buyer != null)
                                            {
                                                <span class="fw-semibold text-dark">@item.Buyer.FullName</span>
                                                <small class="text-muted d-block">Company: @item.Buyer.CompanyName</small>
                                            }
                                            else
                                            {
                                                <div class="d-flex gap-2 align-items-center">
                                                    <span class="text-muted small">Awaiting Buyer</span>
                                                    @if (soldQty == 0)
                                                    {
                                                        <form asp-action="Delete" asp-controller="Marketplace" asp-route-id="@item.ListingId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this listing?');">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" title="Delete Listing">
                                                                <span class="material-icons-round" style="font-size: 1rem;">delete</span>
                                                                Delete
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td class="pe-4 text-end text-muted small">#@item.ListingId</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 2. Incoming & Active Orders Tab -->
    @if (userRole == "Farmer")
    {
        <div class="tab-pane fade" id="active-orders-pane" role="tabpanel" aria-labelledby="active-orders-tab">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-0">
                    @if (!activeIncomingOrders.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <span class="material-icons-round text-muted" style="font-size: 3rem;">shopping_bag</span>
                            <p class="mb-0 mt-2 fw-semibold">No Active Orders</p>
                            <p class="small">There are currently no active incoming requests or dispatches requiring action.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 text-dark">
                                <thead class="table-light text-muted small">
                                    <tr>
                                        <th class="ps-4">Order ID</th>
                                        <th>Order Date</th>
                                        <th>Crop Name</th>
                                        <th>Requested Volume</th>
                                        <th>Billed Total</th>
                                        <th>Buyer Details</th>
                                        <th>Status Stage</th>
                                        <th class="pe-4 text-end" style="min-width: 250px;">Fulfillment Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var o in activeIncomingOrders)
                                    {
                                        string cropName = o.CropListing != null
                                            ? o.CropListing.Harvest.CropCycle.Crop.CropName
                                            : o.Harvest.CropCycle.Crop.CropName;

                                        string unit = o.CropListing != null
                                            ? o.CropListing.Unit
                                            : o.Harvest.Unit;

                                        <tr>
                                            <td class="ps-4 fw-bold">#@o.OrderId</td>
                                            <td class="small text-muted">@o.OrderDate.ToString("dd-MM-yyyy")</td>
                                            <td class="fw-bold">@cropName</td>
                                            <td class="fw-bold text-dark">@o.Quantity.ToString("0.00") @unit</td>
                                            <td class="fw-bold text-success">₹@o.TotalAmount.ToString("N2")</td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div>
                                                        <span class="fw-semibold text-dark">@o.Buyer.FullName</span>
                                                        <small class="text-muted d-block">@o.Buyer.CompanyName</small>
                                                    </div>
                                                    <button type="button" 
                                                            class="btn btn-sm btn-outline-secondary rounded-circle p-1 d-flex align-items-center justify-content-center" 
                                                            data-bs-toggle="modal" 
                                                            data-bs-target="#buyerDetails-active-@o.OrderId"
                                                            title="View buyer contact and delivery details"
                                                            style="width: 30px; height: 30px;">
                                                        <span class="material-icons-round" style="font-size: 18px;">info</span>
                                                    </button>
                                                </div>

                                                <!-- Buyer Details Modal -->
                                                <div class="modal fade" id="buyerDetails-active-@o.OrderId" tabindex="-1">
                                                    <div class="modal-dialog modal-dialog-centered">
                                                        <div class="modal-content border-0 shadow-lg rounded-4">
                                                            <div class="modal-header bg-light border-0">
                                                                <h5 class="modal-title text-dark fw-bold d-flex align-items-center gap-2">
                                                                    <span class="material-icons-round text-success">contact_page</span>
                                                                    Buyer Details - Order #@o.OrderId
                                                                </h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body p-4">
                                                                <div class="mb-4">
                                                                    <h6 class="text-muted text-uppercase small mb-3">Contact Information</h6>
                                                                    <div class="row g-3">
                                                                        <div class="col-12">
                                                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                                                <span class="material-icons-round text-success">person</span>
                                                                                <div>
                                                                                    <small class="text-muted d-block">Buyer Name</small>
                                                                                    <strong>@o.Buyer.FullName</strong>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-12">
                                                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                                                <span class="material-icons-round text-success">business</span>
                                                                                <div>
                                                                                    <small class="text-muted d-block">Company Name</small>
                                                                                    <strong>@o.Buyer.CompanyName</strong>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-12">
                                                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                                                <span class="material-icons-round text-success">phone</span>
                                                                                <div>
                                                                                    <small class="text-muted d-block">Mobile Number</small>
                                                                                    <strong>@o.Buyer.MobileNumber</strong>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                @if (!string.IsNullOrEmpty(o.DeliveryAddress))
                                                                {
                                                                    <hr class="my-4" />
                                                                    <div class="mb-3">
                                                                        <h6 class="text-muted text-uppercase small mb-3">Delivery Address</h6>
                                                                        <div class="alert alert-light border rounded-3 p-3 mb-0">
                                                                            <div class="d-flex gap-2">
                                                                                <span class="material-icons-round text-success">location_on</span>
                                                                                <div class="flex-grow-1">
                                                                                    <p class="mb-0">@o.DeliveryAddress</p>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                            <div class="modal-footer border-0 bg-light">
                                                                <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Close</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge @(o.Status == "Accepted" || o.Status == "Farmer Accepted" || o.Status == "Paid" ? "bg-success" : "bg-warning text-dark") rounded-pill px-2.5 py-1">
                                                    @o.Status
                                                </span>
                                            </td>
                                            <td class="pe-4 text-end">
                                                @if (o.Status == "Pending" || o.Status == "Request Sent" || o.Status == "PENDING_FARMER_ACCEPTANCE" || o.Status == "REQUESTED")
                                                {
                                                    <div class="d-inline-flex gap-2">
                                                        <form asp-action="AcceptOrder" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="orderId" value="@o.OrderId" />
                                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-semibold">
                                                                <i class="fas fa-check me-1"></i> Accept
                                                            </button>
                                                        </form>
                                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#declineModal-@o.OrderId">
                                                            <i class="fas fa-times me-1"></i> Decline
                                                        </button>
                                                    </div>

                                                    <!-- Mandatory Decline Reason Modal -->
                                                    <div class="modal fade text-start" id="declineModal-@o.OrderId" tabindex="-1">
                                                        <div class="modal-dialog modal-dialog-centered">
                                                            <div class="modal-content border-0 shadow-lg rounded-4">
                                                                <form asp-action="DeclineOrder" method="post">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="orderId" value="@o.OrderId" />
                                                                    <div class="modal-header bg-danger text-white border-0">
                                                                        <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                                                                            <span class="material-icons-round">cancel</span>
                                                                            Decline Order Request #@o.OrderId
                                                                        </h5>
                                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                                    </div>
                                                                    <div class="modal-body p-4">
                                                                        <p class="text-muted small mb-3">
                                                                            Please select a mandatory decline reason for declining <strong>@o.Buyer.FullName's</strong> request for <strong>@o.Quantity @unit</strong> of <strong>@cropName</strong>.
                                                                        </p>

                                                                        <label class="form-label fw-bold text-dark">Decline Reason <span class="text-danger">*</span></label>
                                                                        <div class="d-flex flex-column gap-2 mb-3">
                                                                            <div class="form-check">
                                                                                <input class="form-check-input" type="radio" name="declineReason" id="reason1-@o.OrderId" value="Out of Stock" required>
                                                                                <label class="form-check-label" for="reason1-@o.OrderId">Out of Stock</label>
                                                                            </div>
                                                                            <div class="form-check">
                                                                                <input class="form-check-input" type="radio" name="declineReason" id="reason2-@o.OrderId" value="Harvest Delayed">
                                                                                <label class="form-check-label" for="reason2-@o.OrderId">Harvest Delayed</label>
                                                                            </div>
                                                                            <div class="form-check">
                                                                                <input class="form-check-input" type="radio" name="declineReason" id="reason3-@o.OrderId" value="Quality Issue">
                                                                                <label class="form-check-label" for="reason3-@o.OrderId">Quality Issue</label>
                                                                            </div>
                                                                            <div class="form-check">
                                                                                <input class="form-check-input" type="radio" name="declineReason" id="reason4-@o.OrderId" value="Already Sold">
                                                                                <label class="form-check-label" for="reason4-@o.OrderId">Already Sold</label>
                                                                            </div>
                                                                            <div class="form-check">
                                                                                <input class="form-check-input" type="radio" name="declineReason" id="reason5-@o.OrderId" value="Transportation Problem">
                                                                                <label class="form-check-label" for="reason5-@o.OrderId">Transportation Problem</label>
                                                                            </div>
                                                                            <div class="form-check">
                                                                                <input class="form-check-input" type="radio" name="declineReason" id="reason6-@o.OrderId" value="Other">
                                                                                <label class="form-check-label" for="reason6-@o.OrderId">Other Reason</label>
                                                                            </div>
                                                                        </div>

                                                                        <div class="mb-2">
                                                                            <label class="form-label small text-muted">Additional Details (Mandatory if 'Other' selected)</label>
                                                                            <textarea name="declineNotes" class="form-control rounded-3" rows="3" placeholder="Provide details for declining this request..."></textarea>
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer bg-light border-0">
                                                                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                                                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">Confirm Decline</button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    int cRank = o.Status switch
                                                    {
                                                        "Pending" or "Request Sent" => 1,
                                                        "Accepted" or "Farmer Accepted" or "ACCEPTED" => 2,
                                                        "Paid" => 3,
                                                        "Preparing Produce" => 4,
                                                        "Ready for Pickup" => 5,
                                                        "In Transit" => 6,
                                                        "Delivered" or "Completed" => 7,
                                                        _ => 0
                                                    };

                                                    <form asp-action="UpdateOrderStatus" method="post" class="d-inline-flex gap-1 align-items-center">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@o.OrderId" />
                                                        <select name="status" class="form-select form-select-sm rounded-3 py-1" style="width: auto; font-size: 11px;">
                                                            @if (cRank <= 2) { <option value="Accepted" selected="@(o.Status == "Accepted" || o.Status == "Farmer Accepted" ? "selected" : null)">Accepted</option> }
                                                            @if (cRank <= 4) { <option value="Preparing Produce" selected="@(o.Status == "Preparing Produce" ? "selected" : null)">Preparing</option> }
                                                            @if (cRank <= 5) { <option value="Ready for Pickup" selected="@(o.Status == "Ready for Pickup" ? "selected" : null)">Ready for Pickup</option> }
                                                            @if (cRank <= 6) { <option value="In Transit" selected="@(o.Status == "In Transit" ? "selected" : null)">In Transit</option> }
                                                            @if (cRank <= 7) { <option value="Delivered" selected="@(o.Status == "Delivered" ? "selected" : null)">Delivered</option> }
                                                        </select>
                                                        <button type="submit" class="btn btn-sm btn-primary rounded-3 text-nowrap py-1 px-2.5" style="font-size: 11px;">Update</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 3. Order History Tab (Delivered & Declined Closed Orders) -->
        <div class="tab-pane fade" id="history-orders-pane" role="tabpanel" aria-labelledby="history-orders-tab">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-0">
                    @if (!closedHistoryOrders.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <span class="material-icons-round text-muted" style="font-size: 3rem;">history</span>
                            <p class="mb-0 mt-2 fw-semibold">No Order History</p>
                            <p class="small">Delivered sales and declined order requests will appear here.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 text-dark">
                                <thead class="table-light text-muted small">
                                    <tr>
                                        <th class="ps-4">Order ID</th>
                                        <th>Order Date</th>
                                        <th>Crop Name</th>
                                        <th>Requested Volume</th>
                                        <th>Billed Total</th>
                                        <th>Buyer Details</th>
                                        <th>Final Status</th>
                                        <th class="pe-4 text-end">Archive Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var o in closedHistoryOrders)
                                    {
                                        string cropName = o.CropListing != null
                                            ? o.CropListing.Harvest.CropCycle.Crop.CropName
                                            : o.Harvest.CropCycle.Crop.CropName;

                                        string unit = o.CropListing != null
                                            ? o.CropListing.Unit
                                            : o.Harvest.Unit;

                                        <tr>
                                            <td class="ps-4 fw-bold">#@o.OrderId</td>
                                            <td class="small text-muted">@o.OrderDate.ToString("dd-MM-yyyy")</td>
                                            <td class="fw-bold">@cropName</td>
                                            <td class="fw-bold text-dark">@o.Quantity.ToString("0.00") @unit</td>
                                            <td class="fw-bold text-success">₹@o.TotalAmount.ToString("N2")</td>
                                            <td>
                                                <span class="fw-semibold text-dark">@o.Buyer.FullName</span>
                                                <small class="text-muted d-block">@o.Buyer.CompanyName</small>
                                            </td>
                                            <td>
                                                <span class="badge @(o.Status == "Delivered" || o.Status == "Completed" ? "bg-success" : "bg-danger") rounded-pill px-2.5 py-1">
                                                    @o.Status
                                                </span>
                                            </td>
                                            <td class="pe-4 text-end">
                                                @if (o.Status == "Declined" || o.Status == "Rejected" || o.Status == "Cancelled")
                                                {
                                                    <span class="text-danger small fw-bold">
                                                        <i class="fas fa-times-circle me-1"></i> Declined (@(o.DeclineReason ?? "Order Declined"))
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-success small fw-bold">
                                                        <i class="fas fa-check-circle me-1"></i> Order Completed
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
