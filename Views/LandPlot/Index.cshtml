@model IEnumerable<Smart_Farm_and_Crop_Yeild_Management_System.Models.LandPlot>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Land Plots";
}

<div class="row">
    <div class="col-12 d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 text-success">My Land Plots</h2>
            <p class="text-muted mb-0">Monitor and map GPS plots across your registered farms.</p>
        </div>
        <a href="~/LandPlot/Create" class="btn btn-success d-flex align-items-center gap-2">
            <span class="material-icons-round">add_location_alt</span>
            Map New Plot
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <span class="material-icons-round text-muted" style="font-size: 4rem;">map</span>
                <h4 class="mt-3">No Mapped Plots</h4>
                <p class="text-muted">You haven't mapped any land plots yet.</p>
                <a href="~/LandPlot/Create" class="btn btn-success mt-2">Add Land Plot</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="min-width: 800px;">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Plot Name</th>
                            <th>Plot Code</th>
                            <th>Farm</th>
                            <th>Village</th>
                            <th>Area Size</th>
                            <th>Soil Type</th>
                            <th>Irrigation Type</th>
                            <th>GPS (Lat, Lng)</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var plot in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@plot.PlotName</td>
                                <td class="font-monospace text-muted small">@plot.PlotCode</td>
                                <td class="fw-semibold">@plot.Farm.FarmName</td>
                                <td>@plot.Farm.Village</td>
                                <td>@plot.Area @plot.AreaUnit</td>
                                <td>@plot.SoilType</td>
                                <td>@plot.IrrigationType</td>
                                <td class="small text-muted font-monospace">@plot.Latitude.ToString("F6"), @plot.Longitude.ToString("F6")</td>
                                <td>
                                    <span class="badge @(plot.Status == "Active" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") rounded-pill px-3 py-1">
                                        @plot.Status
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group gap-1">
                                        <a href="~/LandPlot/Details/@plot.PlotId" class="btn btn-sm btn-outline-success border-0" title="View Weather &amp; Crops">
                                            <span class="material-icons-round">visibility</span>
                                        </a>
                                        <a href="~/LandPlot/Edit/@plot.PlotId" class="btn btn-sm btn-outline-primary border-0" title="Edit Plot">
                                            <span class="material-icons-round">edit</span>
                                        </a>
                                        <a href="~/LandPlot/Delete/@plot.PlotId" class="btn btn-sm btn-outline-danger border-0" title="Delete Plot">
                                            <span class="material-icons-round">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
