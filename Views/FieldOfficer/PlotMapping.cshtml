@model IEnumerable<Smart_Farm_and_Crop_Yeild_Management_System.Models.LandPlot>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Plot Mapping";
}

<!-- Notification Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="dash-alert dash-alert-green" style="margin-bottom: 20px;">
        <span class="material-icons-round">check_circle</span>
        <div><b>Success:</b> @TempData["SuccessMessage"]</div>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="dash-alert dash-alert-red" style="margin-bottom: 20px;">
        <span class="material-icons-round">error</span>
        <div><b>Error:</b> @TempData["ErrorMessage"]</div>
    </div>
}

<!-- Filters Row -->
<div class="dash-card" style="margin-bottom: 24px;">
    <div class="dash-card-body" style="padding: 20px;">
        <form method="get" action="~/FieldOfficer/PlotMapping" class="d-flex align-end justify-between flex-wrap gap-16">
            <div class="d-flex align-center flex-wrap gap-16" style="flex: 1;">
                <div class="form-group" style="min-width: 250px; flex: 1;">
                    <label class="form-label" style="font-weight:600;">Search Plots</label>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-input" placeholder="Search by name, code, farmer or survey..." />
                </div>
                <div class="form-group" style="min-width: 150px;">
                    <label class="form-label" style="font-weight:600;">Soil Type</label>
                    <select name="soilType" class="form-select">
                        <option value="">All Soils</option>
                        <option value="Black Cotton" selected="@(ViewBag.SoilType == "Black Cotton")">Black Cotton</option>
                        <option value="Red Loam" selected="@(ViewBag.SoilType == "Red Loam")">Red Loam</option>
                        <option value="Sandy Loam" selected="@(ViewBag.SoilType == "Sandy Loam")">Sandy Loam</option>
                        <option value="Clay" selected="@(ViewBag.SoilType == "Clay")">Clay</option>
                        <option value="Mixed" selected="@(ViewBag.SoilType == "Mixed")">Mixed</option>
                    </select>
                </div>
                <div class="form-group" style="min-width: 150px;">
                    <label class="form-label" style="font-weight:600;">Irrigation Type</label>
                    <select name="irrigationType" class="form-select">
                        <option value="">All Irrigation</option>
                        <option value="Drip" selected="@(ViewBag.IrrigationType == "Drip")">Drip</option>
                        <option value="Sprinkler" selected="@(ViewBag.IrrigationType == "Sprinkler")">Sprinkler</option>
                        <option value="Flood" selected="@(ViewBag.IrrigationType == "Flood")">Flood</option>
                        <option value="Rainfed" selected="@(ViewBag.IrrigationType == "Rainfed")">Rainfed</option>
                    </select>
                </div>
            </div>
            <div class="form-actions mb-0" style="display: flex; gap: 8px;">
                <button type="submit" class="btn btn-primary" style="padding: 10px 20px;">
                    <span class="material-icons-round">search</span> Search
                </button>
                <a href="~/FieldOfficer/PlotMapping" class="btn btn-outline" style="padding: 10px 20px;">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Main Plots List -->
<div class="dash-card">
    <div class="dash-card-header">
        <h2 class="dash-card-title">
            <span class="material-icons-round">table_chart</span>
            Registered Agricultural Land Plots
        </h2>
    </div>
    <div class="dash-card-body" style="padding: 0;">
        <div class="dash-table-wrap">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Plot Code</th>
                        <th>Plot Name</th>
                        <th>Survey/Khasra</th>
                        <th>Farmer Name</th>
                        <th>Farm Name</th>
                        <th>Area (Size)</th>
                        <th>Soil Type</th>
                        <th>Irrigation</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var plot in Model)
                        {
                            <tr>
                                <td><b>@plot.PlotCode</b></td>
                                <td>@plot.PlotName</td>
                                <td><span style="font-family: monospace; background: var(--border); padding: 2px 6px; border-radius: 4px;">Farm #@plot.FarmId</span></td>
                                <td>@plot.Farm.Farmer.FullName</td>
                                <td>@plot.Farm.FarmName</td>
                                <td>@plot.Area @plot.AreaUnit</td>
                                <td>@plot.SoilType</td>
                                <td>@plot.IrrigationType</td>
                                <td>
                                    <span class="badge @(plot.Status == "Active" ? "badge-green" : "badge-gray")">@plot.Status</span>
                                </td>
                                <td>
                                    <div style="display:flex; gap: 6px;">
                                        <a href="~/FieldOfficer/PlotMappingDetails/@plot.PlotId" class="btn btn-sm btn-outline">Details</a>
                                        <form method="post" action="~/FieldOfficer/DeletePlot" onsubmit="return confirm('Are you sure you want to delete plot @plot.PlotName?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@plot.PlotId" />
                                            <button type="submit" class="btn btn-sm btn-danger" style="background:#ef4444; border-color:#ef4444;">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" style="text-align:center; color:var(--text-secondary); padding:30px;">
                                No land plots match the current filter.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination -->
@if (ViewBag.TotalPages > 1)
{
    <div class="d-flex justify-center" style="margin-top:20px; gap:8px;">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <a href="~/FieldOfficer/PlotMapping?search=@ViewBag.Search&soilType=@ViewBag.SoilType&irrigationType=@ViewBag.IrrigationType&page=@i" 
               class="btn @(ViewBag.CurrentPage == i ? "btn-primary" : "btn-outline")" style="padding: 6px 12px;">@i</a>
        }
    </div>
}

<!-- Map New Plot Modal -->
<div id="addPlotModal" class="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
    <div class="dash-card" style="width: 100%; max-width: 650px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.25); max-height: 90vh; overflow-y: auto;">
        <div class="dash-card-header d-flex justify-between align-center" style="border-bottom:1px solid var(--border); padding: 15px 20px;">
            <h2 class="dash-card-title mb-0" style="margin: 0;">
                <span class="material-icons-round">add_location</span> Register New Land Plot
            </h2>
            <button class="btn btn-sm btn-outline" onclick="closeAddPlotModal()" style="border: none; padding: 4px 8px;">
                <span class="material-icons-round" style="font-size:20px;">close</span>
            </button>
        </div>
        <div class="dash-card-body" style="padding: 20px;">
            <form class="dash-form" method="post" action="~/FieldOfficer/AddPlot" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label class="form-label" for="FarmId">Select Associated Farm</label>
                    <select id="FarmId" name="FarmId" class="form-select" required>
                        <option value="">-- Choose Farm (Farmer) --</option>
                        @if (ViewBag.Farms != null)
                        {
                            foreach (var farm in ViewBag.Farms)
                            {
                                <option value="@farm.FarmId">@farm.FarmName (@farm.Farmer.FullName)</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-row cols-2">
                    <div class="form-group">
                        <label class="form-label" for="PlotName">Plot Name</label>
                        <input type="text" id="PlotName" name="PlotName" class="form-input" placeholder="e.g. Cotton Patch West" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="PlotCode">Plot Code</label>
                        <input type="text" id="PlotCode" name="PlotCode" class="form-input" placeholder="e.g. W-02" required />
                    </div>
                </div>

                <div class="form-row cols-3">
                    <div class="form-group">
                        <label class="form-label" for="Area">Area Size</label>
                        <input type="number" step="0.01" id="Area" name="Area" class="form-input" placeholder="e.g. 4.5" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="AreaUnit">Area Unit</label>
                        <select id="AreaUnit" name="AreaUnit" class="form-select">
                            <option value="Acre">Acre</option>
                            <option value="Hectare">Hectare</option>
                            <option value="Guntha">Guntha</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="SurveyNumber">Survey / Khasra No.</label>
                        <input type="text" id="SurveyNumber" name="SurveyNumber" class="form-input" placeholder="e.g. 104/A-1" required />
                    </div>
                </div>

                <div class="form-row cols-2">
                    <div class="form-group">
                        <label class="form-label" for="SoilType">Soil Type</label>
                        <select id="SoilType" name="SoilType" class="form-select">
                            <option value="Black Cotton">Black Cotton</option>
                            <option value="Red Loam">Red Loam</option>
                            <option value="Sandy Loam">Sandy Loam</option>
                            <option value="Clay">Clay</option>
                            <option value="Mixed">Mixed</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="IrrigationType">Irrigation Type</label>
                        <select id="IrrigationType" name="IrrigationType" class="form-select">
                            <option value="Drip">Drip</option>
                            <option value="Sprinkler">Sprinkler</option>
                            <option value="Flood">Flood</option>
                            <option value="Rainfed">Rainfed</option>
                        </select>
                    </div>
                </div>

                <div class="form-row cols-2">
                    <div class="form-group">
                        <label class="form-label" for="Latitude">Latitude Coordinate</label>
                        <input type="number" step="0.0001" id="Latitude" name="Latitude" class="form-input" placeholder="e.g. 19.3920" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="Longitude">Longitude Coordinate</label>
                        <input type="number" step="0.0001" id="Longitude" name="Longitude" class="form-input" placeholder="e.g. 74.6530" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="ImageFile">Upload Plot Image/Map</label>
                    <input type="file" id="ImageFile" name="ImageFile" class="form-input" accept="image/*" />
                </div>

                <div class="form-actions" style="border-top:1px solid var(--border); padding-top: 15px; margin-top: 20px;">
                    <button type="submit" class="btn btn-primary">Save Plot</button>
                    <button type="button" class="btn btn-outline" onclick="closeAddPlotModal()">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openAddPlotModal() {
        document.getElementById('addPlotModal').style.display = 'flex';
    }
    function closeAddPlotModal() {
        document.getElementById('addPlotModal').style.display = 'none';
    }
</script>
