@model Smart_Farm_and_Crop_Yeild_Management_System.Models.PestCase
@{
    Layout = "_DashboardLayout";
    var farmer = Model?.CropCycle?.LandPlot?.Farm?.Farmer;
    var existingVisit = ViewBag.ExistingVisit as Smart_Farm_and_Crop_Yeild_Management_System.Models.FieldVisit;
    ViewData["Title"] = $"Incident #{Model?.PestCaseId}";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="dash-alert dash-alert-green" style="margin-bottom:20px;">
        <span class="material-icons-round">check_circle</span>
        <div><b>Success:</b> @TempData["SuccessMessage"]</div>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="dash-alert dash-alert-red" style="margin-bottom:20px;">
        <span class="material-icons-round">error</span>
        <div><b>Error:</b> @TempData["ErrorMessage"]</div>
    </div>
}

<div style="margin-bottom:16px;">
    <a href="/FieldOfficer/IncidentReports" class="btn btn-outline" style="padding:8px 16px;">
        <span class="material-icons-round" style="font-size:16px;vertical-align:middle;">arrow_back</span>
        Back to Incident Reports
    </a>
</div>

<div class="grid-2" style="gap:20px; margin-bottom:20px;">
    <div class="dash-card">
        <div class="dash-card-header">
            <h2 class="dash-card-title"><span class="material-icons-round">report_problem</span> Incident #@Model?.PestCaseId</h2>
        </div>
        <div class="dash-card-body">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
                <div>
                    <label class="form-label" style="color:var(--text-secondary);font-size:0.78rem;">Farmer</label>
                    <p style="font-weight:700;">@(farmer?.FullName ?? "N/A")</p>
                </div>
                <div>
                    <label class="form-label" style="color:var(--text-secondary);font-size:0.78rem;">Phone</label>
                    <p style="font-weight:600;">@(farmer?.MobileNumber ?? "N/A")</p>
                </div>
                <div>
                    <label class="form-label" style="color:var(--text-secondary);font-size:0.78rem;">Crop</label>
                    <p style="font-weight:600;">@(Model?.CropCycle?.Crop?.CropName ?? "N/A")</p>
                </div>
                <div>
                    <label class="form-label" style="color:var(--text-secondary);font-size:0.78rem;">Plot</label>
                    <p style="font-weight:600;">@(Model?.CropCycle?.LandPlot?.PlotCode ?? Model?.CropCycle?.LandPlot?.PlotName ?? "N/A")</p>
                </div>
                <div>
                    <label class="form-label" style="color:var(--text-secondary);font-size:0.78rem;">Priority</label>
                    <p><span class="badge @(Model?.Priority == "High" ? "badge-red" : "badge-orange")">@Model?.Priority</span></p>
                </div>
                <div>
                    <label class="form-label" style="color:var(--text-secondary);font-size:0.78rem;">Status</label>
                    <p><span class="badge badge-orange">@Model?.Status</span></p>
                </div>
            </div>
            <div style="border-top:1px solid var(--border-color);padding-top:14px;">
                <label class="form-label" style="color:var(--text-secondary);font-size:0.78rem;">Issue Description</label>
                <p style="line-height:1.6;">@(Model?.Description ?? "No description.")</p>
            </div>
            @if (!string.IsNullOrEmpty(Model?.Recommendation))
            {
                <div style="border-top:1px solid var(--border-color);padding-top:14px;margin-top:14px;">
                    <label class="form-label" style="color:var(--text-secondary);font-size:0.78rem;">Agronomist Recommendation</label>
                    <p style="line-height:1.6;color:#16a34a;font-weight:600;">@Model.Recommendation</p>
                </div>
            }
        </div>
    </div>

    <div class="dash-card">
        <div class="dash-card-header">
            <h2 class="dash-card-title"><span class="material-icons-round">commute</span> Workflow Progress</h2>
        </div>
        <div class="dash-card-body">
            @if (existingVisit != null)
            {
                <div style="background:var(--bg-secondary);border-radius:10px;padding:14px;margin-bottom:16px;">
                    <label class="form-label" style="color:var(--text-secondary);font-size:0.78rem;">Scheduled Visit</label>
                    <p style="font-weight:700;font-size:1.05rem;">@(existingVisit.VisitDate?.ToString("dd MMM yyyy HH:mm") ?? "Not set")</p>
                    <span class="badge @(existingVisit.Status == "Completed" ? "badge-green" : existingVisit.Status == "Scheduled" ? "badge-blue" : "badge-orange")">@existingVisit.Status</span>
                </div>
            }
            else
            {
                <div style="text-align:center;padding:16px;color:var(--text-secondary);">
                    <span class="material-icons-round" style="font-size:2rem;color:#cbd5e1;">event_available</span>
                    <p style="margin-top:6px;font-size:0.88rem;">No visit scheduled yet.</p>
                </div>
            }
            <div style="border-top:1px solid var(--border-color);padding-top:14px;">
                @{
                    var steps = new[] { "ESCALATED TO OFFICER", "Field Visit Scheduled", "Field Visit Confirmed", "Pending Farmer Approval", "Resolved" };
                    var currentStatus = Model?.Status ?? "";
                    var currentIdx = Array.IndexOf(steps, currentStatus);
                    if (currentIdx < 0)
                    {
                        if (currentStatus.Contains("Scheduled")) currentIdx = 1;
                        else if (currentStatus.Contains("Confirmed") || currentStatus.Contains("Visit")) currentIdx = 2;
                        else if (currentStatus.Contains("Approval")) currentIdx = 3;
                        else if (currentStatus == "Resolved") currentIdx = 4;
                        else currentIdx = 0;
                    }
                }
                @foreach (var item in steps.Select((s, i) => new { s, i }))
                {
                    string dot = item.i < currentIdx ? "#16a34a" : (item.i == currentIdx ? "#2563eb" : "#cbd5e1");
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
                        <span style="width:12px;height:12px;border-radius:50%;background:@dot;flex-shrink:0;"></span>
                        <span style="font-size:0.85rem;@(item.i <= currentIdx ? "font-weight:600;" : "color:var(--text-secondary);")">@item.s</span>
                        @if (item.i == currentIdx) { <span style="font-size:0.7rem;background:#dbeafe;color:#1d4ed8;border-radius:4px;padding:1px 6px;">Current</span> }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (Model?.Status != "Pending Farmer Approval" && Model?.Status != "Resolved" && Model?.Status != "Closed")
{
    <div class="grid-2" style="gap:20px;margin-bottom:20px;">
        <div class="dash-card">
            <div class="dash-card-header">
                <h2 class="dash-card-title"><span class="material-icons-round">event</span> @(existingVisit != null ? "Reschedule Visit" : "Schedule Field Visit")</h2>
            </div>
            <div class="dash-card-body">
                <p style="color:var(--text-secondary);font-size:0.88rem;margin-bottom:16px;">Set a date to visit. The farmer will be notified automatically.</p>
                <form method="post" action="~/FieldOfficer/ScheduleVisitFromIncident">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="pestCaseId" value="@Model?.PestCaseId" />
                    <div class="form-group" style="margin-bottom:16px;">
                        <label class="form-label" for="visitDate">Visit Date &amp; Time</label>
                        <input type="datetime-local" id="visitDate" name="visitDate" class="form-input"
                               value="@(existingVisit?.VisitDate?.ToString("yyyy-MM-ddTHH:mm"))"
                               min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <span class="material-icons-round">notifications_active</span> Save &amp; Notify Farmer
                    </button>
                </form>
            </div>
        </div>

        <div class="dash-card">
            <div class="dash-card-header">
                <h2 class="dash-card-title"><span class="material-icons-round">assignment_turned_in</span> Submit Visit Report</h2>
            </div>
            <div class="dash-card-body">
                <p style="color:var(--text-secondary);font-size:0.88rem;margin-bottom:16px;">After your farm visit, enter your observations and guidance. The farmer will approve or request a re-visit.</p>
                <form method="post" action="~/FieldOfficer/ResolveIncident">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="pestCaseId" value="@Model?.PestCaseId" />
                    <div class="form-group" style="margin-bottom:16px;">
                        <label class="form-label" for="fieldReport">Field Report &amp; Findings</label>
                        <textarea id="fieldReport" name="fieldReport" class="form-input" rows="5" required
                                  placeholder="Describe your observations, diagnosis, and recommended action..." style="resize:vertical;">@(Model?.FieldReport ?? "")</textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100" style="background:#16a34a;border-color:#16a34a;">
                        <span class="material-icons-round">send</span> Submit Report &amp; Notify Farmer for Approval
                    </button>
                </form>
            </div>
        </div>
    </div>
}

@if (Model?.Status == "Pending Farmer Approval")
{
    <div class="dash-card" style="margin-bottom:20px;">
        <div class="dash-card-header">
            <h2 class="dash-card-title"><span class="material-icons-round">hourglass_top</span> Awaiting Farmer Approval</h2>
        </div>
        <div class="dash-card-body">
            <div class="dash-alert dash-alert-green">
                <span class="material-icons-round">check_circle</span>
                <div><b>Report submitted.</b> The farmer has been notified and must approve the resolution before this case is closed.</div>
            </div>
            @if (!string.IsNullOrEmpty(Model?.FieldReport))
            {
                <div style="margin-top:16px;">
                    <label class="form-label" style="color:var(--text-secondary);">Your Submitted Report</label>
                    <div style="background:var(--bg-secondary);border-radius:8px;padding:14px;line-height:1.6;">@Model.FieldReport</div>
                </div>
            }
        </div>
    </div>
}

@if (Model?.Status == "Resolved")
{
    <div class="dash-card">
        <div class="dash-card-header">
            <h2 class="dash-card-title"><span class="material-icons-round">verified</span> Case Resolved — Approved by Farmer</h2>
        </div>
        <div class="dash-card-body">
            <div class="dash-alert dash-alert-green">
                <span class="material-icons-round">task_alt</span>
                <div><b>This case is fully resolved and approved by the farmer.</b></div>
            </div>
            @if (!string.IsNullOrEmpty(Model?.FieldReport))
            {
                <div style="margin-top:16px;">
                    <label class="form-label" style="color:var(--text-secondary);">Field Officer Report</label>
                    <div style="background:var(--bg-secondary);border-radius:8px;padding:14px;line-height:1.6;">@Model.FieldReport</div>
                </div>
            }
        </div>
    </div>
}
