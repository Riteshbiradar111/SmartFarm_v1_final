@model Smart_Farm_and_Crop_Yeild_Management_System.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register Account - Smart Farm";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-gradient-success text-white text-center py-4" style="background: linear-gradient(135deg, #1e7e34, #28a745);">
                    <h3 class="fw-bold mb-1"><i class="bi bi-person-plus-fill me-2"></i>Create New Account</h3>
                    <p class="mb-0 text-white-50 fs-6">Register as a Farmer or Buyer to access Smart Farm</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Role Selection Radio -->
                        <div class="mb-4 text-center">
                            <label class="form-label fw-bold d-block mb-2">I want to register as a:</label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="RoleName" id="roleFarmer" value="Farmer" checked autocomplete="off">
                                <label class="btn btn-outline-success py-2 fw-semibold" for="roleFarmer"><i class="bi bi-person-workspace me-1"></i> Farmer</label>

                                <input type="radio" class="btn-check" name="RoleName" id="roleBuyer" value="Buyer" autocomplete="off">
                                <label class="btn btn-outline-primary py-2 fw-semibold" for="roleBuyer"><i class="bi bi-cart-check me-1"></i> Buyer</label>
                            </div>
                        </div>

                        <!-- Full Name -->
                        <div class="form-floating mb-3">
                            <input asp-for="FullName" class="form-control" placeholder="John Doe" required />
                            <label asp-for="FullName"><i class="bi bi-person me-1"></i> Full Name</label>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- Email & Phone Row -->
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" required />
                                    <label asp-for="Email"><i class="bi bi-envelope me-1"></i> Email</label>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Phone" type="tel" class="form-control" placeholder="9876543210" required />
                                    <label asp-for="Phone"><i class="bi bi-telephone me-1"></i> Phone</label>
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Username -->
                        <div class="form-floating mb-3">
                            <input asp-for="Username" class="form-control" placeholder="username" required />
                            <label asp-for="Username"><i class="bi bi-at me-1"></i> Choose Username</label>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <!-- Password Row -->
                        <div class="row g-2 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Password" type="password" class="form-control" placeholder="Password" required />
                                    <label asp-for="Password"><i class="bi bi-lock me-1"></i> Password</label>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm Password" required />
                                    <label asp-for="ConfirmPassword"><i class="bi bi-shield-lock me-1"></i> Confirm Password</label>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 py-3 fw-bold rounded-3 shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Register Now
                        </button>
                    </form>
                </div>
                <div class="card-footer bg-light text-center py-3">
                    <span class="text-muted fs-6">Already have an account? </span>
                    <a asp-action="Login" class="fw-bold text-success text-decoration-none ms-1">Log In Here</a>
                </div>
            </div>
        </div>
    </div>
</div>
