@{
	Layout = "_Layout";
	ViewData["Title"] = "Forgot Password";
	ViewData["Description"] = "Reset your SmartFarm account password securely.";
}

@section Styles {
	<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}
	<div class="auth-layout">

		<!-- ===== LEFT PANEL — Image & Branding ===== -->
		<div class="auth-left">
			<!-- Background image -->
			<div class="auth-left-bg">
				<img src="https://images.unsplash.com/photo-1625246333195-78d9c38ad449?w=1000&q=85"
					 alt="Secure farming" />
				<div class="auth-left-overlay"></div>
			</div>

			<!-- Branding content -->
			<div class="auth-left-content">
				<a href="~/Home/Index" class="auth-logo">
					<span class="material-icons">eco</span>
					<div>
						<span class="auth-logo-name">SmartFarm</span>
						<span class="auth-logo-tagline">Crop Yield Management System</span>
					</div>
				</a>

				<div class="auth-left-headline">
					<h1>Secure Your<br /><span>Account</span></h1>
					<p>Reset your password and regain access to your farm management dashboard.</p>
				</div>
			</div>
		</div>

		<!-- ===== RIGHT PANEL — Forgot Password Form ===== -->
		<div class="auth-right">
			<div class="auth-form-wrap">

				<!-- Back to Login -->
				<a href="~/Auth/Login" class="auth-back-link">
					<span class="material-icons">arrow_back</span>
					Back to Login
				</a>

				<!-- Form header -->
				<div class="auth-form-header">
					<div class="auth-form-icon">
						<span class="material-icons">lock_reset</span>
					</div>
					<h2>Forgot Your Password?</h2>
					<p>Enter your username or email to reset your password.</p>
				</div>

				<!-- Error Messages -->
				@if (ViewData["ErrorMessage"] != null)
				{
					<div style="padding:12px 16px; background:#fee2e2; border:1px solid #fca5a5; border-radius:8px; color:#991b1b; font-size:0.85rem; margin-bottom:16px; display:flex; align-items:center; gap:8px;">
						<span class="material-icons" style="font-size:18px;">error_outline</span>
						@ViewData["ErrorMessage"]
					</div>
				}

				@if (ViewData["UserFound"] != null && (bool)ViewData["UserFound"])
				{
					<!-- Success card -->
					<div style="padding:16px; background:#d1fae5; border:1px solid #6ee7b7; border-radius:12px; color:#065f46; margin-bottom:20px;">
						<div style="display:flex; align-items:start; gap:12px;">
							<span class="material-icons" style="color:#059669; font-size:24px;">check_circle</span>
							<div>
								<h6 style="margin:0 0 8px; font-weight:600; font-size:0.95rem;">Account Verified!</h6>
								<p style="margin:4px 0; font-size:0.85rem;"><strong>Username:</strong> @ViewData["Username"]</p>
								<p style="margin:4px 0; font-size:0.85rem;"><strong>Email:</strong> @ViewData["Email"]</p>
								<hr style="margin:10px 0; border-color:#6ee7b7;" />
								<p style="margin:0; font-size:0.85rem;">Now set a new password for your account.</p>
							</div>
						</div>
					</div>

						<!-- Reset Password Form -->
						<form asp-action="ResetPassword" method="post" class="auth-form">
							@Html.AntiForgeryToken()
							<input type="hidden" name="username" value="@ViewData["Username"]" />

							<!-- New Password -->
							<div class="form-group">
								<label for="newPassword" class="form-label">
									<span class="material-icons">lock</span>
									New Password
								</label>
								<div class="input-wrap">
									<input type="password"
										   id="newPassword"
										   name="newPassword"
										   class="form-input"
										   placeholder="Enter new password"
										   minlength="6"
										   required
										   autofocus />
								</div>
								<small style="color:#666; font-size:0.8rem; margin-top:4px; display:block;">Minimum 6 characters</small>
							</div>

							<!-- Confirm Password -->
							<div class="form-group">
								<label for="confirmPassword" class="form-label">
									<span class="material-icons">lock_clock</span>
									Confirm New Password
								</label>
								<div class="input-wrap">
									<input type="password"
										   id="confirmPassword"
										   name="confirmPassword"
										   class="form-input"
										   placeholder="Re-enter new password"
										   minlength="6"
										   required />
								</div>
							</div>

							<!-- Submit Button -->
							<button type="submit" class="auth-submit-btn">
								<span class="material-icons">lock_reset</span>
								Reset Password
							</button>
						</form>
					}
							else
							{
								<!-- Verification Form -->
								<form asp-action="ForgotPassword" method="post" class="auth-form">
									@Html.AntiForgeryToken()

									<!-- Email or Username Input -->
									<div class="form-group">
										<label for="emailOrUsername" class="form-label">
											<span class="material-icons">person</span>
											Email or Username
										</label>
										<div class="input-wrap">
											<input type="text"
												   id="emailOrUsername"
												   name="emailOrUsername"
												   class="form-input"
												   placeholder="Enter your email or username"
												   required
												   autofocus />
										</div>
									</div>

									<!-- Submit Button -->
									<button type="submit" class="auth-submit-btn">
										<span class="material-icons">search</span>
										Recover Password
									</button>
								</form>
							}

							<!-- Divider -->
							<div class="auth-divider">
								<span>Remember your password?</span>
							</div>

							<!-- Sign In Link -->
							<a href="~/Auth/Login" class="auth-secondary-btn">
								<span class="material-icons">login</span>
								Sign In
							</a>

						</div>
					</div>
				</div>
