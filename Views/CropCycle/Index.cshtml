@model IEnumerable<Smart_Farm_and_Crop_Yeild_Management_System.Models.CropCycle>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Crop Cycles";
}

<div class="row">
    <div class="col-12 d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 text-success">Crop Sowing Cycles</h2>
            <p class="text-muted mb-0">Monitor crop cycles, durations, and expected harvests.</p>
        </div>
        <a href="~/CropCycle/Create" class="btn btn-success d-flex align-items-center gap-2">
            <span class="material-icons-round">grass</span>
            Sow New Crop
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <span class="material-icons-round text-muted" style="font-size: 4rem;">eco</span>
                <h4 class="mt-3">No Crops Sown</h4>
                <p class="text-muted">You haven't recorded any crop sowing cycles yet.</p>
                <a href="~/CropCycle/Create" class="btn btn-success mt-2">Sow New Crop</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="min-width: 800px;">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Crop Name</th>
                            <th>Plot Name</th>
                            <th>Farm Name</th>
                            <th>Sowing Date</th>
                            <th>Expected Harvest</th>
                            <th>Growth Stage</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cycle in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-success">@cycle.Crop.CropName</td>
                                <td class="fw-semibold text-dark">@cycle.LandPlot.PlotName</td>
                                <td>@cycle.LandPlot.Farm.FarmName</td>
                                <td>@cycle.SowingDate.ToString("dd-MM-yyyy")</td>
                                <td>@cycle.ExpectedHarvestDate.ToString("dd-MM-yyyy")</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-3 py-1">
                                        @cycle.CurrentStage
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(cycle.Status == "Active" ? "bg-success-subtle text-success" : cycle.Status == "Completed" ? "bg-info-subtle text-info" : "bg-danger-subtle text-danger") rounded-pill px-3 py-1">
                                        @cycle.Status
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group gap-1">
                                        <a href="~/CropCycle/Edit/@cycle.CropCycleId" class="btn btn-sm btn-outline-primary border-0" title="Edit Stage">
                                            <span class="material-icons-round">edit</span>
                                        </a>
                                        <a href="~/CropCycle/Delete/@cycle.CropCycleId" class="btn btn-sm btn-outline-danger border-0" title="Delete">
                                            <span class="material-icons-round">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
