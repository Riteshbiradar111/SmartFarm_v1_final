@model IEnumerable<Smart_Farm_and_Crop_Yeild_Management_System.Models.Harvest>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Harvest Records";
}

<div class="row">
    <div class="col-12 d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 text-success">Harvest Yield Records</h2>
            <p class="text-muted mb-0">Review actual quantities harvested vs expected parameters.</p>
        </div>
        <a href="~/Harvest/Create" class="btn btn-success d-flex align-items-center gap-2">
            <span class="material-icons-round">agriculture</span>
            Record Harvest
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <span class="material-icons-round text-muted" style="font-size: 4rem;">agriculture</span>
                <h4 class="mt-3">No Harvests Logged</h4>
                <p class="text-muted">You haven't recorded any crop harvests yet.</p>
                <a href="~/Harvest/Create" class="btn btn-success mt-2">Log Harvest</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="min-width: 800px;">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Harvest Date</th>
                            <th>Crop Name</th>
                            <th>Plot &amp; Farm</th>
                            <th>Expected Quantity</th>
                            <th>Actual Yield Quantity</th>
                            <th>Variance</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            var variance = log.ActualQuantity - log.ExpectedQuantity;
                            var variancePercent = log.ExpectedQuantity > 0 ? (variance / log.ExpectedQuantity) * 100 : 0;
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@log.HarvestDate.ToString("dd-MM-yyyy")</td>
                                <td class="fw-semibold text-success">@log.CropCycle.Crop.CropName</td>
                                <td>@log.CropCycle.LandPlot.PlotName (@log.CropCycle.LandPlot.Farm.FarmName)</td>
                                <td>@log.ExpectedQuantity @log.Unit</td>
                                <td class="fw-bold">@log.ActualQuantity @log.Unit</td>
                                <td>
                                    @if (variance >= 0)
                                    {
                                        <span class="text-success small fw-semibold">+@variance.ToString("F1") (@variancePercent.ToString("F0")%)</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger small fw-semibold">@variance.ToString("F1") (@variancePercent.ToString("F0")%)</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">@log.Status</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex gap-2 justify-content-end">
                                        @if (!log.CropListings.Any())
                                        {
                                            <a href="~/Marketplace/Create?harvestId=@log.HarvestId" class="btn btn-sm btn-success d-inline-flex align-items-center gap-1">
                                                <span class="material-icons-round" style="font-size: 1.1rem;">storefront</span>
                                                Sell Produce
                                            </a>
                                            <form asp-action="Delete" asp-controller="Harvest" asp-route-id="@log.HarvestId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this harvest record?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" title="Delete Harvest">
                                                    <span class="material-icons-round" style="font-size: 1.1rem;">delete</span>
                                                    Delete
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1">Listed</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
