@model IEnumerable<Smart_Farm_and_Crop_Yeild_Management_System.Models.Wishlist>
@{
    Layout = "_BuyerLayout";
    ViewData["Title"] = "My Saved Items";
}

<div class="row mb-4">
    <div class="col-12">
        <a href="~/BuyerMarketplace" class="text-success d-inline-flex align-items-center gap-1 mb-2 text-decoration-none">
            <span class="material-icons-round">arrow_back</span> Back to Marketplace
        </a>
        <h2 class="text-success">My Wishlist &amp; Alerts</h2>
        <p class="text-muted mb-0">Browse saved crops, favorite farmers, and manage out-of-stock notification settings.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-4">@TempData["SuccessMessage"]</div>
}

<div class="row g-4">
    <!-- Saved Crops Grid -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <h5 class="text-dark fw-bold mb-3 d-flex align-items-center gap-2">
                <span class="material-icons-round text-danger">favorite</span>
                Saved Crops &amp; Alert Subscriptions
            </h5>

            @{
                var savedCrops = Model.Where(w => w.CropId.HasValue).ToList();
            }

            @if (!savedCrops.Any())
            {
                <div class="text-center py-4 text-muted">
                    <p class="small mb-0">You haven't saved any crops to your wishlist yet.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in savedCrops)
                    {
                        <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <a href="@Url.Action("Index", "BuyerMarketplace", new { searchCrop = item.Crop.CropName })" class="text-decoration-none flex-grow-1">
                                <strong class="text-dark">@item.Crop.CropName</strong>
                                <small class="text-muted d-block">Season: @item.Crop.Season</small>

                                @if (item.NotifyWhenAvailable)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill mt-1 small d-inline-flex align-items-center gap-1" style="font-size: 9px;">
                                        <span class="material-icons-round font-size-sm">notifications</span> Notify Enabled
                                    </span>
                                }
                                <small class="text-success d-block mt-1">
                                    <span class="material-icons-round" style="font-size: 14px; vertical-align: middle;">storefront</span> Click to view marketplace listings
                                </small>
                            </a>
                            <div class="d-flex gap-2">
                                <form asp-action="ToggleNotifyMe" asp-controller="BuyerMarketplace" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cropId" value="@item.CropId" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning rounded-3">
                                        <span class="material-icons-round font-size-sm">notifications</span>
                                    </button>
                                </form>
                                <form asp-action="ToggleWishlist" asp-controller="BuyerMarketplace" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cropId" value="@item.CropId" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-3">Remove</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Favorite Farmers Grid -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <h5 class="text-dark fw-bold mb-3 d-flex align-items-center gap-2">
                <span class="material-icons-round text-primary">people</span>
                Favorite Farmers Directory
            </h5>

            @{
                var savedFarmers = Model.Where(w => w.FarmerId.HasValue).ToList();
            }

            @if (!savedFarmers.Any())
            {
                <div class="text-center py-4 text-muted">
                    <p class="small mb-0">You haven't saved any farmers to your favorites list yet.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in savedFarmers)
                    {
                        <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <a href="@Url.Action("Index", "BuyerMarketplace", new { searchFarmer = item.Farmer.FullName })" class="text-decoration-none flex-grow-1">
                                <strong class="text-dark">@item.Farmer.FullName</strong>
                                <small class="text-muted d-block">Location: @item.Farmer.Village, @item.Farmer.District</small>
                                <small class="text-success d-block mt-1">
                                    <span class="material-icons-round" style="font-size: 14px; vertical-align: middle;">storefront</span> Click to view farmer's current listings
                                </small>
                            </a>
                            <form asp-action="ToggleWishlist" asp-controller="BuyerMarketplace" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="farmerId" value="@item.FarmerId" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-3">Remove</button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
