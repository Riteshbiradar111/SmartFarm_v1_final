@model SmartFarmMVC.Models.ViewModels.BuyerProfileViewModel
@{
    Layout = "_BuyerLayout";
    ViewData["Title"] = "Buyer Profile";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="text-success mb-1">My Account Settings</h2>
        <p class="text-muted mb-0">Update your company credentials, contact mobile numbers, and shipping address records.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <span class="material-icons-round align-middle me-1">check_circle</span> @TempData["SuccessMessage"]
    </div>
}
@if (ViewData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <span class="material-icons-round align-middle me-1">error</span> @ViewData["ErrorMessage"]
    </div>
}

<div class="row g-4">
    <!-- LEFT COLUMN: Profile info display -->
    <div class="col-md-5 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
            @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
            {
                <div class="d-inline-block position-relative mb-3">
                    <img src="@Model.ProfilePicturePath" alt="Profile Picture" class="rounded-circle shadow-sm" style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #198754;" />
                </div>
            }
            else
            {
                <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-3" style="width: 120px; height: 120px;">
                    <span class="material-icons-round" style="font-size: 4rem;">business</span>
                </div>
            }
            <h4 class="text-dark fw-bold mb-1">@Model.FullName</h4>
            <span class="badge bg-primary rounded-pill px-3 py-1 mb-3">@Model.CompanyName</span>

            <div class="border-top pt-3 text-start small text-muted">
                <p class="mb-2"><strong>Mobile:</strong> @Model.MobileNumber</p>
                <p class="mb-2"><strong>City:</strong> @Model.City</p>
                <p class="mb-0"><strong>Address:</strong> @Model.Address, @Model.State - @Model.PinCode</p>
            </div>
        </div>
    </div>

    <!-- RIGHT COLUMN: Profile edit form -->
    <div class="col-md-7 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="text-dark fw-bold mb-3 border-bottom pb-2">Edit Account Information</h5>

            <form asp-action="Profile" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <!-- Profile Picture Upload -->
                    <div class="col-12">
                        <label asp-for="ProfilePictureFile" class="form-label fw-bold text-dark small">Upload Profile Photo (Images only)</label>
                        <input asp-for="ProfilePictureFile" type="file" class="form-control rounded-3" accept="image/*" />
                        <span asp-validation-for="ProfilePictureFile" class="text-danger small"></span>
                    </div>

                    <!-- Full Name -->
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-bold text-dark small">Full Name *</label>
                        <input asp-for="FullName" class="form-control rounded-3" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <!-- Company Name -->
                    <div class="col-md-6">
                        <label asp-for="CompanyName" class="form-label fw-bold text-dark small">Company / Agency Name *</label>
                        <input asp-for="CompanyName" class="form-control rounded-3" required />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>

                    <!-- Mobile Number -->
                    <div class="col-md-6">
                        <label asp-for="MobileNumber" class="form-label fw-bold text-dark small">Mobile Number *</label>
                        <input asp-for="MobileNumber" class="form-control rounded-3" required />
                        <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                    </div>

                    <!-- Address -->
                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label fw-bold text-dark small">Business Address *</label>
                        <input asp-for="Address" class="form-control rounded-3" required />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <!-- City -->
                    <div class="col-md-4">
                        <label asp-for="City" class="form-label fw-bold text-dark small">City *</label>
                        <input asp-for="City" class="form-control rounded-3" required />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>

                    <!-- State -->
                    <div class="col-md-4">
                        <label asp-for="State" class="form-label fw-bold text-dark small">State *</label>
                        <input asp-for="State" class="form-control rounded-3" required />
                        <span asp-validation-for="State" class="text-danger small"></span>
                    </div>

                    <!-- Pin Code -->
                    <div class="col-md-4">
                        <label asp-for="PinCode" class="form-label fw-bold text-dark small">Pin Code *</label>
                        <input asp-for="PinCode" class="form-control rounded-3" required />
                        <span asp-validation-for="PinCode" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Save Changes</button>
                </div>
            </form>
        </div>

        <!-- Change Password Section -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mt-4">
            <h5 class="text-dark fw-bold mb-3 border-bottom pb-2 d-flex align-items-center gap-2">
                <span class="material-icons-round text-warning">lock</span>
                Change Password
            </h5>

            <form asp-action="ChangePassword" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <!-- Current Password -->
                    <div class="col-12">
                        <label for="currentPassword" class="form-label fw-bold text-dark small">Current Password *</label>
                        <input type="password" 
                               name="currentPassword" 
                               id="currentPassword" 
                               class="form-control rounded-3" 
                               placeholder="Enter your current password" 
                               required />
                        <small class="text-muted">For security verification</small>
                    </div>

                    <!-- New Password -->
                    <div class="col-md-6">
                        <label for="newPassword" class="form-label fw-bold text-dark small">New Password *</label>
                        <input type="password" 
                               name="newPassword" 
                               id="newPassword" 
                               class="form-control rounded-3" 
                               placeholder="Enter new password" 
                               minlength="6"
                               required />
                        <small class="text-muted">Minimum 6 characters</small>
                    </div>

                    <!-- Confirm New Password -->
                    <div class="col-md-6">
                        <label for="confirmPassword" class="form-label fw-bold text-dark small">Confirm New Password *</label>
                        <input type="password" 
                               name="confirmPassword" 
                               id="confirmPassword" 
                               class="form-control rounded-3" 
                               placeholder="Re-enter new password" 
                               minlength="6"
                               required />
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold">
                        <span class="material-icons-round align-middle me-1" style="font-size: 1rem;">lock_reset</span>
                        Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
