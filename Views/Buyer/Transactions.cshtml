@model IEnumerable<Smart_Farm_and_Crop_Yeild_Management_System.Models.CropOrder>
@{
	Layout = "_BuyerLayout";
	ViewData["Title"] = "Transaction History";
	var orderMap = ViewBag.OrderNumberMap as Dictionary<int, int>;
}

<div class="row mb-4">
	<div class="col-12">
		<h2 class="text-success mb-1">Transaction History</h2>
		<p class="text-muted mb-0">Complete record of all your orders, payments, and transaction details.</p>
	</div>
</div>

@if (TempData["SuccessMessage"] != null)
{
	<div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
		<div class="d-flex align-items-center gap-2">
			<span class="material-icons-round">check_circle</span>
			<div>
				<strong>Payment Confirmed!</strong>
				<p class="mb-0 small">@TempData["SuccessMessage"]</p>
			</div>
		</div>
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

<!-- Summary Statistics Cards -->
<div class="row g-4 mb-4">
	<div class="col-md-3">
		<div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #2d6a4f 0%, #40916c 100%);">
			<span class="text-white-50 small text-uppercase d-block mb-1">Total Transactions</span>
			<h3 class="fw-bold mb-0">@ViewBag.TotalTransactions</h3>
		</div>
	</div>
	<div class="col-md-3">
		<div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #1d3557 0%, #457b9d 100%);">
			<span class="text-white-50 small text-uppercase d-block mb-1">Total Paid</span>
			<h3 class="fw-bold mb-0">₹@ViewBag.TotalSpent.ToString("N2")</h3>
		</div>
	</div>
	<div class="col-md-3">
		<div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #f77f00 0%, #fcbf49 100%);">
			<span class="text-white-50 small text-uppercase d-block mb-1">Pending Orders</span>
			<h3 class="fw-bold mb-0">@ViewBag.PendingOrders</h3>
		</div>
	</div>
	<div class="col-md-3">
		<div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #06a77d 0%, #1bbc9b 100%);">
			<span class="text-white-50 small text-uppercase d-block mb-1">Completed</span>
			<h3 class="fw-bold mb-0">@ViewBag.CompletedOrders</h3>
		</div>
	</div>
</div>

<!-- Filter Panel -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
	<div class="card-body p-4">
		<h5 class="text-dark fw-bold mb-3 d-flex align-items-center gap-2">
			<span class="material-icons-round text-success">filter_alt</span>
			Filter by Status
		</h5>
		<form method="get" asp-action="Transactions" class="row g-3 align-items-end">
			<div class="col-md-4">
				<label class="form-label fw-semibold text-dark">Transaction Status</label>
				<select name="status" class="form-select rounded-3">
					<option value="">All Statuses</option>
					<option value="Paid" selected="@(ViewBag.Status == "Paid")">Paid</option>
					<option value="Preparing Produce" selected="@(ViewBag.Status == "Preparing Produce")">Preparing Produce</option>
					<option value="Ready for Pickup" selected="@(ViewBag.Status == "Ready for Pickup")">Ready for Pickup</option>
					<option value="In Transit" selected="@(ViewBag.Status == "In Transit")">In Transit</option>
					<option value="Delivered" selected="@(ViewBag.Status == "Delivered")">Delivered</option>
					<option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>
				</select>
			</div>
			<div class="col-md-3 d-flex gap-2">
				<button type="submit" class="btn btn-success rounded-3 px-4">
					<span class="material-icons-round" style="font-size: 18px; vertical-align: middle;">search</span>
					Filter
				</button>
				<a href="@Url.Action("Transactions")" class="btn btn-outline-secondary rounded-3 px-3">
					<span class="material-icons-round" style="font-size: 18px;">refresh</span>
				</a>
			</div>
		</form>
	</div>
</div>

<!-- Transactions Table -->
@if (Model != null && Model.Any())
{
	<div class="card border-0 shadow-sm rounded-4">
		<div class="card-body p-0">
			<div class="table-responsive">
				<table class="table table-hover align-middle mb-0">
					<thead class="bg-light">
						<tr>
							<th class="px-4 py-3 text-dark fw-bold">Order ID</th>
							<th class="py-3 text-dark fw-bold">Date</th>
							<th class="py-3 text-dark fw-bold">Crop</th>
							<th class="py-3 text-dark fw-bold">Farmer</th>
							<th class="py-3 text-dark fw-bold text-end">Quantity</th>
							<th class="py-3 text-dark fw-bold text-end">Amount</th>
							<th class="py-3 text-dark fw-bold text-center">Status</th>
							<th class="py-3 text-dark fw-bold text-center">Actions</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var transaction in Model)
						{
							var cropName = "";
							var farmerName = "";

							if (transaction.CropListing != null)
							{
								cropName = transaction.CropListing.Harvest?.CropCycle?.Crop?.CropName ?? "N/A";
								farmerName = transaction.CropListing.Harvest?.CropCycle?.LandPlot?.Farm?.Farmer?.FullName ?? transaction.Farmer?.FullName ?? "Unknown";
							}
							else if (transaction.Harvest != null)
							{
								cropName = transaction.Harvest.CropCycle?.Crop?.CropName ?? "N/A";
								farmerName = transaction.Harvest.CropCycle?.LandPlot?.Farm?.Farmer?.FullName ?? transaction.Farmer?.FullName ?? "Unknown";
							}
							else
							{
								farmerName = transaction.Farmer?.FullName ?? "Unknown";
							}

							var transactionUnit = transaction.CropListing?.Unit ?? transaction.Harvest?.Unit ?? "kg";

							var statusBadge = transaction.Status switch
							{
								"Paid" => "bg-success text-white",
								"PAID_ESCROW" => "bg-success text-white",
								"Preparing Produce" => "bg-info text-white",
								"Ready for Pickup" => "bg-primary text-white",
								"In Transit" => "bg-warning text-dark",
								"Delivered" => "bg-success text-white",
								"Completed" => "bg-success text-white",
								_ => "bg-secondary text-white"
							};

							var seqNo = orderMap != null && orderMap.ContainsKey(transaction.OrderId) ? orderMap[transaction.OrderId] : transaction.OrderId;

							<tr>
								<td class="px-4 py-3">
									<div class="d-flex align-items-center gap-2">
										<span class="badge bg-light text-dark border">#@seqNo</span>
										<!-- Payment Confirmed Badge -->
										<span class="badge bg-success-subtle text-success border border-success rounded-pill px-2 py-1 small">
											<span class="material-icons-round align-middle" style="font-size: 14px;">verified</span>
											Paid
										</span>
									</div>
								</td>
								<td class="py-3 text-muted small">
									<div class="d-flex flex-column">
										<span class="fw-semibold text-dark">@transaction.OrderDate.ToString("MMM dd, yyyy")</span>
										<span class="text-muted" style="font-size: 0.75rem;">@transaction.OrderDate.ToString("hh:mm tt")</span>
									</div>
								</td>
								<td class="py-3">
									<span class="fw-semibold text-dark">@cropName</span>
								</td>
								<td class="py-3 text-muted">
									@farmerName
								</td>
								<td class="py-3 text-end">
									<span class="fw-semibold text-dark">@transaction.Quantity.ToString("0.##") @transactionUnit</span>
								</td>
								<td class="py-3 text-end">
									<span class="fw-bold text-success">₹@transaction.TotalAmount.ToString("N2")</span>
								</td>
								<td class="py-3 text-center">
									<span class="badge @statusBadge rounded-pill px-3 py-2">@transaction.Status</span>
								</td>
								<td class="py-3 text-center">
									<a href="@Url.Action("Details", "BuyerOrder", new { id = transaction.OrderId })" class="btn btn-sm btn-outline-success rounded-3">
										<span class="material-icons-round" style="font-size: 16px; vertical-align: middle;">visibility</span>
										View
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}
else
{
	<div class="card border-0 shadow-sm rounded-4 p-5 text-center text-muted">
		<span class="material-icons-round text-muted mb-3" style="font-size: 4rem;">receipt_long</span>
		<h5 class="fw-bold mb-2">No Transactions Found</h5>
		<p class="mb-3">No paid transactions are available yet, or no results match your filter criteria.</p>
		<a href="@Url.Action("Index", "BuyerMarketplace")" class="btn btn-success rounded-3 px-4">
			<span class="material-icons-round" style="font-size: 18px; vertical-align: middle;">storefront</span>
			Browse Marketplace
		</a>
	</div>
}

@section Scripts {
	<script>
		// Highlight current page in sidebar
		document.getElementById('nav-tx')?.classList.add('active');
	</script>
}
