@model SmartFarmMVC.Models.ViewModels.SupportQueryViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Raise Support Query";
    var farms = ViewBag.Farms as IEnumerable<Smart_Farm_and_Crop_Yeild_Management_System.Models.Farm> ?? new List<Smart_Farm_and_Crop_Yeild_Management_System.Models.Farm>();
    var plots = ViewBag.Plots as IEnumerable<Smart_Farm_and_Crop_Yeild_Management_System.Models.LandPlot> ?? new List<Smart_Farm_and_Crop_Yeild_Management_System.Models.LandPlot>();
}

<div class="row mb-4">
    <div class="col-12">
        <a href="~/Support" class="text-success d-inline-flex align-items-center gap-1 mb-2 text-decoration-none">
            <span class="material-icons-round">arrow_back</span> Back to Support History
        </a>
        <h2 class="text-success">Raise Support Request</h2>
        <p class="text-muted mb-0">Select a query category and enter details. Your request will automatically route to the right expert.</p>
    </div>
</div>

@if (ViewData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible show fade mb-4" role="alert">
        <span class="material-icons-round align-middle me-1">error</span> @ViewData["ErrorMessage"]
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="QueryType" class="form-label fw-bold text-dark">Query Type *</label>
                        <select asp-for="QueryType" class="form-select rounded-3" required>
                            <option value="">-- Choose Category --</option>
                            <option value="General Farming Query">General Farming Query</option>
                            <option value="Field Visit Request">Field Visit Request</option>
                            <option value="Irrigation Issue">Irrigation Issue</option>
                            <option value="Equipment Issue">Equipment Issue</option>
                            <option value="Crop Issue">Crop Issue</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="QueryType" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Priority" class="form-label fw-bold text-dark">Urgency Priority *</label>
                        <select asp-for="Priority" class="form-select rounded-3" required>
                            <option value="Low">Low - Normal response</option>
                            <option value="Medium">Medium - Priority response</option>
                            <option value="High">High - Critical threat</option>
                        </select>
                        <span asp-validation-for="Priority" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold text-dark">Short Summary Title *</label>
                    <input asp-for="Title" class="form-control rounded-3" placeholder="e.g. Drip pipeline leakage, Yellow wilt on Cotton leaves" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold text-dark">Detailed Description *</label>
                    <textarea asp-for="Description" class="form-control rounded-3" rows="5" placeholder="Provide complete details about the query, symptoms noticed, or support request..." required></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="FarmId" class="form-label fw-bold text-dark">Associated Farm *</label>
                        <select asp-for="FarmId" class="form-select rounded-3" required>
                            <option value="">-- Select Farm --</option>
                            @foreach (var farm in farms)
                            {
                                <option value="@farm.FarmId">@farm.FarmName</option>
                            }
                        </select>
                        <span asp-validation-for="FarmId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PlotId" class="form-label fw-bold text-dark">Affected Land Plot (Optional)</label>
                        <select asp-for="PlotId" class="form-select rounded-3">
                            <option value="">-- Select Plot --</option>
                            @foreach (var plot in plots)
                            {
                                <option value="@plot.PlotId">@plot.PlotName (@plot.PlotCode)</option>
                            }
                        </select>
                        <span asp-validation-for="PlotId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="ImageFile" class="form-label fw-bold text-dark">Attach Photo (Optional)</label>
                    <input asp-for="ImageFile" type="file" accept="image/*" class="form-control rounded-3" />
                    <span class="text-muted small d-block mt-1">Submit a clear picture if reporting crop disease or damaged equipment.</span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="~/Support" class="btn btn-light rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Submit Query</button>
                </div>
            </form>
        </div>
    </div>
</div>
