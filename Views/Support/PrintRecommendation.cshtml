@model Smart_Farm_and_Crop_Yeild_Management_System.Models.SupportQuery
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agronomist Recommendation - Ticket #@Model.QueryId</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
            body {
                font-family: 'Inter', sans-serif;
                background-color: #fff;
                color: #1a202c;
                padding: 40px;
                margin: 0;
                line-height: 1.5;
            }

            .header {
                border-bottom: 2px solid #2d6a4f;
                padding-bottom: 20px;
                margin-bottom: 30px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .header h1 {
                    color: #1b4332;
                    margin: 0;
                    font-size: 24px;
                }

                .header p {
                    margin: 5px 0 0 0;
                    color: #718096;
                    font-size: 14px;
                }

            .ticket-info {
                background-color: #f7fafc;
                border: 1px solid #e2e8f0;
                border-radius: 8px;
                padding: 20px;
                margin-bottom: 30px;
            }

                .ticket-info table {
                    width: 100%;
                    border-collapse: collapse;
                }

                .ticket-info td {
                    padding: 8px 12px;
                    font-size: 14px;
                }

                    .ticket-info td.label {
                        font-weight: 600;
                        color: #4a5568;
                        width: 30%;
                    }

            .advisory-box {
                border: 1px solid #2d6a4f;
                background-color: #f4fcf6;
                border-radius: 8px;
                padding: 25px;
                margin-bottom: 30px;
            }

                .advisory-box h3 {
                    color: #2d6a4f;
                    margin-top: 0;
                    margin-bottom: 15px;
                    font-size: 18px;
                }

            .footer {
                text-align: center;
                color: #a0aec0;
                font-size: 12px;
                margin-top: 50px;
                border-top: 1px solid #e2e8f0;
                padding-top: 20px;
            }

            .no-print {
                text-align: right;
                margin-bottom: 20px;
            }

            .btn {
                background-color: #2d6a4f;
                color: white;
                border: none;
                padding: 10px 20px;
                font-weight: 600;
                border-radius: 6px;
                cursor: pointer;
            }

                .btn:hover {
                    background-color: #1b4332;
                }

            @@media print {
                .no-print {
                    display: none !important;
                }

                body {
                    padding: 0;
                }
            }
    </style>
</head>
<body>
    <div class="no-print">
        <button onclick="window.print()" class="btn">Print / Save as PDF</button>
    </div>

    <div class="header">
        <div>
            <h1>Smart Farm ERP Portal</h1>
            <p>Official Agronomy Recommendation Report</p>
        </div>
        <div style="text-align: right;">
            <strong>Ticket ID: #@Model.QueryId</strong>
            <p>Issued: @(Model.RecommendationDate?.ToString("dd-MM-yyyy HH:mm") ?? "-")</p>
        </div>
    </div>

    <div class="ticket-info">
        <h3>Ticket Context Information</h3>
        <table>
            <tr>
                <td class="label">Query Category:</td>
                <td>@Model.QueryType</td>
                <td class="label">Priority Level:</td>
                <td>@Model.Priority</td>
            </tr>
            <tr>
                <td class="label">Original Title:</td>
                <td>@Model.Title</td>
                <td class="label">Assigned Farm:</td>
                <td>@Model.Farm.FarmName</td>
            </tr>
            <tr>
                <td class="label">Land Plot Location:</td>
                <td>@(Model.LandPlot?.PlotName ?? "General Farm") (@(Model.LandPlot?.PlotCode ?? "N/A"))</td>
                <td class="label">Farmer ID:</td>
                <td>@Model.FarmerId</td>
            </tr>
        </table>
    </div>

    <div class="advisory-box">
        <h3>Official Treatment &amp; Advisory Recommendation</h3>
        <p style="white-space: pre-wrap; font-size: 15px; margin: 0; line-height: 1.6;">@Model.AgronomistRecommendation</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ImprovementActions))
    {
        <div style="margin-top: 30px;">
            <h3 style="color: #1a202c; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px;">Long-Term Improvement Guidelines</h3>
            <p><strong>Recommended Actions:</strong> @Model.ImprovementActions</p>
            <p><strong>Expected Benefits:</strong> @Model.ImprovementExpectedBenefits</p>
        </div>
    }

    <div class="footer">
        This document is generated automatically by the Smart Farm and Crop Yield Management System.
    </div>

    <script>
            // Trigger print menu automatically on page load
            window.addEventListener('DOMContentLoaded', () => {
                setTimeout(() => {
                    window.print();
                }, 500);
            });
    </script>
</body>
</html>
